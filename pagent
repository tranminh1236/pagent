cmd_init() {
  log "Quét source: $PAGENT_SOURCE"
  mkdir -p "$PAGENT_SOURCE/.pagent"
  PAGENT_TASK_ID="$(new_task_id)"
  PAGENT_MODE="init"
  PAGENT_RUN_DIR="$PAGENT_REPORT_DIR/$PAGENT_PROJECT/runs/$PAGENT_TASK_ID"
  mkdir -p "$PAGENT_RUN_DIR"
  export PAGENT_TASK_ID PAGENT_MODE PAGENT_RUN_DIR PAGENT_PROJECT PAGENT_REPORT_DIR

  # Ghi source path để web server map project→source (xem cmd_pipeline).
  printf '%s\n' "$PAGENT_SOURCE" >"$PAGENT_REPORT_DIR/$PAGENT_PROJECT/.source"

  local out_path="$PAGENT_SOURCE/.pagent/source-summary.md"
  local response
  response="$(echo "Quét folder $PAGENT_SOURCE và trả về markdown summary theo skill source-summary." \
    | call_agent source-summary)" || die "agent fail"

  # Strip code fence bao ngoài nếu agent vẫn cố bọc
  printf '%s\n' "$response" | sed -E '1{/^```/d;}; ${/^```$/d;}' >"$out_path"

  if [[ -s "$out_path" ]]; then
    log "$(c_green 'OK') — wrote $out_path ($(wc -c <"$out_path") bytes)"
    head -10 "$out_path" >&2
  else
    warn "Response rỗng. Xem $PAGENT_RUN_DIR/source-summary.txt"
  fi
}

# Truthy: 1|true|yes|on (case-insensitive) — dùng cho cờ env confirm. Bash 3.2-safe.
_is_truthy() {
  case "$1" in
    1|true|TRUE|True|yes|YES|Yes|on|ON|On) return 0 ;;
    *) return 1 ;;
  esac
}

# In tóm tắt plan ra stderr (header `──────── PLAN ────────`, không kèm "cần xác nhận"
# để dùng chung cho cả nhánh confirm lẫn skip). $1 = plan_json.
_print_plan_summary() {
  local pj="$1"
  local q_title q_summary q_coder q_agents q_risk q_affected q_flow
  q_title="$(jq -r '.title // "(no title)"' <<<"$pj" 2>/dev/null)"
  q_summary="$(jq -r '.summary // "(no summary)"' <<<"$pj" 2>/dev/null)"
  q_coder="$(jq -r '.coder_task // "(no coder_task)"' <<<"$pj" 2>/dev/null)"
  q_agents="$(jq -r '.required_agents // [] | join(", ")' <<<"$pj" 2>/dev/null)"
  q_risk="$(jq -r '.risk // "medium"' <<<"$pj" 2>/dev/null)"
  q_affected="$(jq -r '.affected_paths // [] | join(", ")' <<<"$pj" 2>/dev/null)"
  # flow_diagram (optional): field vắng/rỗng → bỏ qua im lặng (backward-compat).
  q_flow="$(jq -r '.flow_diagram // ""' <<<"$pj" 2>/dev/null)"

  {
    printf '\n%s\n' "$(c_cyan '──────── PLAN ────────')"
    printf '  %s %s\n' "$(c_dim 'title      :')" "$q_title"
    printf '  %s %s\n' "$(c_dim 'summary    :')" "$q_summary"
    printf '  %s %s\n' "$(c_dim 'coder_task :')" "$q_coder"
    printf '  %s %s\n' "$(c_dim 'agents     :')" "${q_agents:-(full pipeline)}"
    printf '  %s %s\n' "$(c_dim 'risk       :')" "$q_risk"
    printf '  %s %s\n' "$(c_dim 'affected   :')" "${q_affected:-(none)}"
    if [[ -n "$q_flow" ]]; then
      printf '  %s\n' "$(c_dim 'Sơ đồ logic task:')"
      while IFS= read -r _fl; do
        printf '    %s\n' "$_fl"
      done <<<"$q_flow"
    fi
  } >&2

  # clarifying_questions (optional): orchestrator có thể hỏi lại để user bổ sung.
  if jq -e '(.clarifying_questions | type == "array") and (.clarifying_questions | length > 0)' <<<"$pj" >/dev/null 2>&1; then
    printf '  %s\n' "$(c_yellow 'orchestrator hỏi:')" >&2
    jq -r '.clarifying_questions[]' <<<"$pj" 2>/dev/null | while IFS= read -r _q; do
      printf '    • %s\n' "$_q" >&2
    done
  fi
}

# Handshake xác nhận plan qua file — cho web / non-tty (không hỏi được qua /dev/tty).
# Ghi plan ra $RUN_DIR/plan.pending.json rồi POLL $RUN_DIR/decision.json (web POST vào).
#   action=run   → return 0 (chạy pipeline)
#   action=edit  → set CONFIRM_EXTRA, return 1 (caller re-run orchestrator với info bổ sung)
#   action=cancel→ exit 0 (hủy)
# Hết PAGENT_CONFIRM_TIMEOUT giây không có quyết định → HỦY (an toàn: không tự sửa file).
confirm_plan_via_file() {
  local pj="$1"
  local pend="$PAGENT_RUN_DIR/plan.pending.json"
  local dec="$PAGENT_RUN_DIR/decision.json"
  rm -f "$dec"
  printf '%s\n' "$pj" >"$pend"
  # Summary đã được gate in TRƯỚC khi gọi hàm này → không in lại (tránh double-print web).
  log "$(c_cyan 'PLAN chờ xác nhận') — mở web dashboard để [Chạy] / [Sửa] / [Hủy]"
  local timeout="${PAGENT_CONFIRM_TIMEOUT:-1800}" waited=0
  while :; do
    if [[ -f "$dec" ]]; then
      local action extra
      action="$(jq -r '.action // "run"' "$dec" 2>/dev/null || echo run)"
      extra="$(jq -r '.extra // ""' "$dec" 2>/dev/null || echo "")"
      rm -f "$dec"
      case "$action" in
        run)    rm -f "$pend"; log "$(c_green 'xác nhận') plan (web) — chạy pipeline"; return 0 ;;
        cancel) rm -f "$pend"; log "$(c_yellow 'hủy') bởi user (web) — không chạy pipeline"; exit 0 ;;
        edit)   rm -f "$pend"; CONFIRM_EXTRA="$extra"; log "$(c_cyan 'sửa plan') (web) — lập lại plan"; return 1 ;;
        *)      rm -f "$pend"; return 0 ;;
      esac
    fi
    sleep 2; waited=$((waited + 2))
    if (( waited >= timeout )); then
      rm -f "$pend"
      warn "hết thời gian chờ xác nhận (${timeout}s) — hủy để tránh tự sửa file"
      exit 0
    fi
  done
}

# Confirm gate sau khi orchestrator ra plan: in tóm tắt cho user qua stderr rồi hỏi qua /dev/tty.
#   return 0  → user xác nhận / bỏ qua gate → tiếp tục pipeline
#   return 1  → user nhập text bổ sung (set CONFIRM_EXTRA) → caller re-run orchestrator
#   n/q       → hủy gọn (exit 0)
# Tự bỏ qua (return 0) khi PAGENT_NO_CONFIRM/PAGENT_YES truthy, hoặc không có tty
# → giữ backward-compat cho chạy tự động / web.
confirm_plan_gate() {
  local pj="$1"
  CONFIRM_EXTRA=""

  # In summary TRƯỚC mọi nhánh skip → PAGENT_NO_CONFIRM/PAGENT_YES/non-tty đều thấy plan.
  _print_plan_summary "$pj"

  if _is_truthy "${PAGENT_NO_CONFIRM:-}" || _is_truthy "${PAGENT_YES:-}"; then
    return 0
  fi
  # Không có tty (vd web spawn với stdin=DEVNULL): nếu PAGENT_CONFIRM bật → handshake
  # qua file (web POST decision). Không bật → auto-run (backward-compat automation).
  if [[ ! -t 0 || ! -e /dev/tty ]]; then
    if _is_truthy "${PAGENT_CONFIRM:-}"; then
      confirm_plan_via_file "$pj"; return $?
    fi
    return 0
  fi

  # Summary đã in ở trên (trước nhánh skip); ở đây chỉ cần dòng prompt.
  printf '%s\n' "$(c_cyan '(cần xác nhận)')" >&2
  printf '\n%s ' "$(c_cyan '[Enter/y] chạy · [n/q] hủy · hoặc gõ thông tin bổ sung →')" >&2
  local reply
  IFS= read -r reply </dev/tty || { printf '\n' >&2; return 0; }

  case "$reply" in
    ""|y|Y|yes|YES|có|co) return 0 ;;
    n|N|q|Q|no|NO)        log "$(c_yellow 'hủy') bởi user — không chạy pipeline"; exit 0 ;;
    *)                    CONFIRM_EXTRA="$reply"; return 1 ;;
  esac
}

cmd_pipeline() {
  local mode="$1" task="$2"
  [[ "$mode" =~ ^(feature|hotfix|chore|find)$ ]] || die "mode phải là feature, hotfix, chore hoặc find"
  [[ -n "$task" ]] || die "thiếu task"

  PAGENT_MODE="$mode"
  # PAGENT_TASK_ID có thể được set sẵn từ caller (vd web chat) để poll deterministic.
  PAGENT_TASK_ID="${PAGENT_TASK_ID:-$(new_task_id)}"
  PAGENT_RUN_DIR="$PAGENT_REPORT_DIR/$PAGENT_PROJECT/runs/$PAGENT_TASK_ID"
  mkdir -p "$PAGENT_RUN_DIR"
  export PAGENT_TASK_ID PAGENT_MODE PAGENT_RUN_DIR PAGENT_PROJECT PAGENT_REPORT_DIR

  # Ghi source path để web server (chỉ biết REPORT_DIR) map project→source khi spawn pagent.
  printf '%s\n' "$PAGENT_SOURCE" >"$PAGENT_REPORT_DIR/$PAGENT_PROJECT/.source"

  acquire_run_lock
  # PID để web Cancel kill được cả cây process (pagent + claude con).
  printf '%s\n' "$$" >"$PAGENT_RUN_DIR/pagent.pid"

  log "project=$PAGENT_PROJECT mode=$mode task_id=$PAGENT_TASK_ID"
  log "source=$PAGENT_SOURCE"
  echo "$task" >"$PAGENT_RUN_DIR/task.txt"
  # Persist mode (từ vựng ĐÃ-dispatch: feature|hotfix|chore|find) để web retry tái dựng
  # đúng loại run gốc TỪ ĐĨA — không tin client. Atomic tmp+mv (như decision.json/cancelled).
  printf '%s\n' "$PAGENT_MODE" >"$PAGENT_RUN_DIR/mode.txt.tmp" \
    && mv -f "$PAGENT_RUN_DIR/mode.txt.tmp" "$PAGENT_RUN_DIR/mode.txt"

  # Đảm bảo có source-summary
  if [[ ! -f "$PAGENT_SOURCE/.pagent/source-summary.md" ]]; then
    warn "chưa có .pagent/source-summary.md → chạy: pagent init"
  fi

  # Lineage: task có thể tham chiếu report cũ qua @<task_id> (hoặc PAGENT_PARENT env).
  # Resolve chain GỐC→CON → nhét vào input orchestrator để hiểu toàn bộ context.
  PAGENT_PARENT="${PAGENT_PARENT:-$(extract_parent_ref "$task" || true)}"
  local parent_context=""
  if [[ -n "$PAGENT_PARENT" ]]; then
    if parent_context="$(build_lineage_context "$PAGENT_PARENT")" && [[ -n "$parent_context" ]]; then
      log "  parent: $(c_green "@$PAGENT_PARENT") (lineage $(grep -c '^### report @' <<<"$parent_context") report)"
    else
      warn "parent @$PAGENT_PARENT — không tìm thấy report tương ứng (bỏ qua lineage)"
      PAGENT_PARENT=""
    fi
  fi
  export PAGENT_PARENT

  #────── 0. Context planning (feature/hotfix) — lọc bối cảnh → CONTEXT_BRIEF ──────
  # Chạy TRƯỚC orchestrator: đọc knowledge/report/git diff theo tầng, xuất brief đã
  # lọc theo task để orchestrator lập plan nhanh. Cache theo git+workflow+knowledge hash.
  # PAGENT_KNOWLEDGE=0 → tắt hẳn (backward-compat). Fail/thiếu → degrade, brief rỗng.
  local context_brief=""
  if { [[ "$mode" == "feature" || "$mode" == "hotfix" ]]; } && _is_truthy "${PAGENT_KNOWLEDGE:-1}"; then
    log "$(c_cyan '[0]') context-planning → lọc bối cảnh liên quan"
    context_brief="$(build_context_brief "$mode" "$task")" || context_brief=""
    [[ -n "$context_brief" ]] && log "  context brief: $(c_green "$(printf '%s' "$context_brief" | wc -l | tr -d ' ') dòng")"
  fi

  #────── 1. Orchestrator (confirm gate → có thể re-run với info bổ sung) ──────
  local step_total=4
  [[ "$mode" == "find" ]] && step_total=2
  log "$(c_cyan "[1/$step_total]") orchestrator → lập plan"
  local plan_text plan_json
  local title coder_task reviewer_focus tester_task risk affected business_context=""
  local n_subtasks=0 n_tester_subtasks=0
  local extra_info="" orch_round=0 orch_max=3
  local prev_plan_json=""   # plan hợp lệ vòng trước — re-run SỬA thay vì khám phá lại + fallback khi re-run fail

  while :; do
    local orch_rc=0
    plan_text="$( {
      echo "## MODE"; echo "$mode"; echo
      echo "## SOURCE_SUMMARY_PATH"; echo ".pagent/source-summary.md"; echo
      if [[ -n "$parent_context" ]]; then
        echo "## PARENT_CONTEXT (lineage report cũ, thứ tự GỐC→CON — hiểu toàn bộ context, ĐỪNG làm lại việc đã xong)"
        echo "$parent_context"; echo
      fi
      echo "## TASK"; echo "$task"
      # CONTEXT_BRIEF: bối cảnh liên quan do bước [0] context-planning lọc sẵn. Rỗng
      # (degrade / mode chore-find / tắt) → bỏ qua im lặng (orchestrator tự đọc summary).
      if [[ -n "$context_brief" ]]; then
        echo; echo "## CONTEXT_BRIEF (bối cảnh liên quan đã lọc sẵn ở bước [0] — dùng để lập plan nhanh, ĐỪNG khám phá lại rộng)"
        echo "$context_brief"
      fi
      # Re-run (có ADDITIONAL_INFO): đưa plan vòng trước vào để orchestrator SỬA theo
      # info bổ sung, KHÔNG khám phá lại toàn bộ codebase từ đầu — re-explore stateless
      # là lý do vòng 2 đốt hết max_turns dù vòng 1 vừa đủ.
      if [[ -n "$prev_plan_json" ]]; then
        echo; echo "## PREVIOUS_PLAN (JSON vòng trước — SỬA/BỔ SUNG theo ADDITIONAL_INFO, chỉ đọc thêm file thật sự cần)"
        echo "$prev_plan_json"
      fi
      # NB: phải dùng `if ... fi` (không phải `[[ ]] &&`) — đây là lệnh CUỐI của
      # brace group bên trái pipe. Với `set -o pipefail`, `[[ -n "" ]]` (extra_info
      # rỗng ở vòng đầu) exit 1 → cả pipeline nonzero dù call_agent OK → die oan.
      if [[ -n "$extra_info" ]]; then echo; echo "## ADDITIONAL_INFO"; echo "$extra_info"; fi
    } | call_agent orchestrator )" || orch_rc=$?

    if (( orch_rc != 0 )); then
      # Re-run fail (vd max_turns): nếu đã có plan hợp lệ vòng trước → giữ lại, tự tiếp
      # tục thay vì vứt cả run. Chỉ die khi fail ngay vòng đầu (chưa có gì để giữ).
      [[ -n "$prev_plan_json" ]] || die "orchestrator fail"
      warn "orchestrator re-run fail (reason đã log ở trên) — giữ plan vòng trước, tự tiếp tục"
      plan_json="$prev_plan_json"
    elif [[ "$mode" == "find" ]]; then
      # find: orchestrator THƯỜNG trả lời câu hỏi bằng văn xuôi (curl/giải thích) thay vì
      # xuất plan JSON — vì task find BẢN THÂN là câu hỏi, model (nhất là qua opencode/9router,
      # frontmatter model bị bỏ qua) nhảy thẳng vào trả lời như reviewer. Ta KHÔNG parse output
      # nó thành plan: extract_json hay chộp nhầm cái `{}` ĐẦU TIÊN trong prose (vd body curl
      # `-d '{…}'`) — object hợp lệ nhưng KHÔNG có .title → "orchestrator JSON parse fail" giả.
      # Plan find chỉ cần giao câu hỏi cho reviewer nên tổng hợp THẲNG bằng bash (deterministic).
      # Prose vẫn nằm ở orchestrator.txt → đưa reviewer làm context (## ORCHESTRATOR_PLAN).
      plan_json="$(jq -n --arg task "$task" '{
        title: ("Find: " + ($task | .[0:70])),
        summary: "find — reviewer đọc source trả lời câu hỏi",
        coder_task: "",
        reviewer_focus: $task,
        tester_task: "",
        risk: "low",
        required_agents: ["reviewer"],
        affected_paths: []
      }')"
    else
      plan_json="$(echo "$plan_text" | extract_json 2>/dev/null || true)"
      if ! jq -e '.title' <<<"$plan_json" >/dev/null 2>&1; then
        warn "plan JSON không parse được — fallback plan tối thiểu"
        warn "raw output ở: $PAGENT_RUN_DIR/orchestrator.txt (đầu 40 dòng):"
        head -40 "$PAGENT_RUN_DIR/orchestrator.txt" >&2
        plan_json="$(jq -n --arg task "$task" '{
          title: "(orchestrator JSON parse fail)",
          summary: "fallback — coder làm task trực tiếp",
          coder_task: $task,
          reviewer_focus: "general correctness",
          tester_task: "",
          risk: "medium",
          affected_paths: []
        }')"
      fi
    fi

    title="$(jq -r '.title' <<<"$plan_json")"
    coder_task="$(jq -r '.coder_task' <<<"$plan_json")"
    reviewer_focus="$(jq -r '.reviewer_focus' <<<"$plan_json")"
    tester_task="$(jq -r '.tester_task // ""' <<<"$plan_json")"
    risk="$(jq -r '.risk // "medium"' <<<"$plan_json")"
    affected="$(jq -r '.affected_paths // [] | join(", ")' <<<"$plan_json")"
    business_context="$(jq -r '.business_context // ""' <<<"$plan_json" 2>/dev/null || true)"

    # coder_subtasks (optional): plan lớn tách ≥2 task con độc lập → fan-out coder.
    # Thiếu field / không phải mảng / rỗng → 0 (giữ luồng coder đơn — backward-compat).
    n_subtasks=0
    if jq -e '(.coder_subtasks | type == "array") and (.coder_subtasks | length > 0)' <<<"$plan_json" >/dev/null 2>&1; then
      n_subtasks="$(jq -r '.coder_subtasks | length' <<<"$plan_json")"
    fi

    # tester_subtasks (optional): plan tách test ≥2 phạm vi độc lập → fan-out tester.
    # Thiếu field / không phải mảng / rỗng → 0 (giữ luồng tester đơn — backward-compat).
    n_tester_subtasks=0
    if jq -e '(.tester_subtasks | type == "array") and (.tester_subtasks | length > 0)' <<<"$plan_json" >/dev/null 2>&1; then
      n_tester_subtasks="$(jq -r '.tester_subtasks | length' <<<"$plan_json")"
    fi

    # required_agents: gate spawn theo plan. Thiếu field / parse lỗi → full pipeline (backward-compat).
    if jq -e '.required_agents | type == "array"' <<<"$plan_json" >/dev/null 2>&1; then
      local _ra; _ra="$(jq -r '.required_agents[]' <<<"$plan_json" 2>/dev/null | tr '\n' ' ')"
      # coder luôn chạy — ép có mặt dù plan quên liệt kê (trừ find: read-only, không spawn coder)
      if [[ "$mode" != "find" ]]; then
        [[ " $_ra " == *" coder "* ]] || _ra="coder $_ra"
      fi
      PAGENT_GATE=1
      PAGENT_REQUIRED_AGENTS=" $_ra "
      log "  required_agents: $(c_green "$_ra")"
    else
      PAGENT_GATE=0
      PAGENT_REQUIRED_AGENTS=""
      log "$(c_dim '  required_agents: (thiếu/parse lỗi) → chạy full pipeline')"
    fi

    log "  title: $(c_green "$title")  risk=$risk"

    # Nhớ plan hợp lệ mới nhất — vòng re-run kế đưa vào PREVIOUS_PLAN; đồng thời là
    # fallback nếu re-run kế fail.
    prev_plan_json="$plan_json"

    # Re-run vừa fail nhưng đã fallback về plan cũ → tự tiếp tục, không hỏi lại (tránh
    # loop hỏi mãi cùng 1 plan khi orchestrator liên tục fail).
    if (( orch_rc != 0 )); then break; fi

    # User xác nhận plan / bổ sung info / hủy. Tty → hỏi /dev/tty; web (PAGENT_CONFIRM) →
    # handshake file; non-tty không bật confirm hoặc PAGENT_YES/NO_CONFIRM → tự chạy.
    confirm_plan_gate "$plan_json" && break
    orch_round=$((orch_round + 1))
    extra_info="${extra_info:+$extra_info$'\n'}$CONFIRM_EXTRA"
    if (( orch_round >= orch_max )); then
      log "$(c_dim "  đã đạt $orch_max vòng bổ sung → tự tiếp tục với plan hiện tại")"
      break
    fi
    log "  re-run orchestrator (vòng $((orch_round + 1))/$orch_max) với thông tin bổ sung…"
  done

  # Tầng review mới: architecture/performance/security chạy SONG SONG, Leader Code
  # (reviewer) chưng RULE (PHA 0) + cân đối verdict (PHA 1). Auditor enabled = giao
  # required_agents (khi PAGENT_GATE=1); gate off → cả 3 (full pipeline backward-compat).
  local -a ENABLED_AUDITORS=()
  local _aud
  for _aud in architecture performance security; do
    agent_enabled "$_aud" && ENABLED_AUDITORS+=("$_aud")
  done

  # Ngân sách vòng review: CHUNG là PAGENT_MAX_REVIEW_ROUND; Leader Code (reviewer) giữ
  # ngân sách chung → đọc override riêng nếu reviewer.md khai báo field max_review_round.
  local eff_max_round="$PAGENT_MAX_REVIEW_ROUND"
  local _rv_mrr; _rv_mrr="$(agent_meta reviewer max_review_round 2>/dev/null | tr -d '[:space:]')"
  [[ "$_rv_mrr" =~ ^[0-9]+$ ]] && { eff_max_round="$_rv_mrr"; log "$(c_dim "  max_review_round override (reviewer.md): $eff_max_round")"; }
  # Clamp ngân sách vòng vào [1, cap] (cap mặc định 5) — chặn env/frontmatter set số lớn đốt
  # token, và chặn giá trị rác/0 khiến vòng coder↔review không chạy lần nào.
  local _round_cap="${PAGENT_MAX_REVIEW_ROUND_CAP:-5}"
  [[ "$eff_max_round" =~ ^[0-9]+$ ]] || eff_max_round=1
  (( eff_max_round < 1 )) && eff_max_round=1
  (( eff_max_round > _round_cap )) && { log "$(c_dim "  eff_max_round $eff_max_round > cap $_round_cap → clamp $_round_cap")"; eff_max_round="$_round_cap"; }

  #────── 1b. Designer (feature, khi task động đến UI) ──────
  # Gating: nếu plan có required_agents → theo list; nếu không → fallback keyword-detect.
  local design_spec="" want_designer=0
  if [[ "$mode" == "feature" ]]; then
    if [[ "${PAGENT_GATE}" == "1" ]]; then
      agent_enabled designer && want_designer=1
    elif printf '%s\n%s\n%s' "$task" "$coder_task" "$affected" \
           | grep -qiE 'ui|giao diện|screen|màn hình|component|layout|button|form|page|frontend|design|css|style|màu|theme|icon|responsive'; then
      want_designer=1
    fi
  fi
  if [[ "$mode" == "feature" && "${PAGENT_GATE}" == "1" && $want_designer -eq 0 ]]; then
    log_skip "designer — không nằm trong required_agents"
  fi
  if (( want_designer )); then
    log "$(c_cyan '[+]') designer → design spec"
    local designer_text
    designer_text="$( {
      echo "## MODE"; echo "$mode"; echo
      echo "## TASK"; echo "$task"; echo
      echo "## PLAN"; cat "$PAGENT_RUN_DIR/orchestrator.txt"; echo
      echo "## CODER_TASK"; echo "$coder_task"
    } | call_agent designer )" || warn "designer fail (tiếp tục không có design spec)"
    if [[ -n "$designer_text" ]]; then
      design_spec="$(echo "$designer_text" | extract_json 2>/dev/null || true)"
      if jq -e . >/dev/null 2>&1 <<<"$design_spec"; then
        printf '%s\n' "$design_spec" >"$PAGENT_RUN_DIR/designer.txt"
        log "  design spec: $(c_green "$(jq -r '.title // "(design spec)"' <<<"$design_spec" 2>/dev/null)")"
      else
        warn "design spec JSON không parse được — bỏ qua"
        design_spec=""
      fi
    fi
  fi

  #────── 1c. DevOps (SỚM — init/thiếu file hạ tầng) ──────
  # Chạy TRƯỚC coder: sinh Dockerfile/docker-compose (dev+deploy), CI (.gitlab-ci.yml),
  # chốt env vars đồng bộ .env.pagent/.env.pagent.example. Gating: plan có required_agents
  # → theo list (mirror ENABLED_AUDITORS/designer); gate off → fallback keyword+phát hiện
  # thiếu file hạ tầng (Dockerfile/compose/.gitlab-ci.yml). Skip ở mode=find (read-only).
  local want_devops=0
  if [[ "$mode" != "find" ]]; then
    if [[ "${PAGENT_GATE}" == "1" ]]; then
      agent_enabled devops && want_devops=1
    elif printf '%s\n%s' "$task" "$coder_task" \
           | grep -qiE 'docker|dockerfile|compose|ci/cd|gitlab-ci|pipeline ci|deploy|hạ tầng|infra|khởi tạo|init project|env var|biến môi trường' \
         && { [[ ! -f "$PAGENT_SOURCE/Dockerfile" ]] || [[ ! -f "$PAGENT_SOURCE/.gitlab-ci.yml" ]] \
              || { [[ ! -f "$PAGENT_SOURCE/docker-compose.yml" ]] && [[ ! -f "$PAGENT_SOURCE/docker-compose.yaml" ]]; }; }; then
      want_devops=1
    fi
  fi
  if [[ "$mode" != "find" && "${PAGENT_GATE}" == "1" ]] && ! agent_enabled devops; then
    log_skip "devops — không nằm trong required_agents"
  fi
  if (( want_devops )); then
    log "$(c_cyan '[+]') devops → Dockerfile/compose/CI + chốt env"
    {
      echo "## MODE"; echo "$mode"; echo
      echo "## TASK"; echo "$task"; echo
      echo "## PLAN"; cat "$PAGENT_RUN_DIR/orchestrator.txt"; echo
      [[ -n "$business_context" ]] && { echo "## BUSINESS_CONTEXT"; echo "$business_context"; echo; }
      echo "## CODER_TASK"; echo "$coder_task"
    } | call_agent devops >/dev/null || warn "devops fail (tiếp tục không có hạ tầng mới)"
  fi

  #────── 2. Coder ↔ Reviewer loop (skip toàn bộ khi mode=find — chỉ đọc + trả lời) ──────
  local round=1 verdict="CHANGES_REQUESTED" coder_input="$coder_task"
  local review_enabled=1
  # Find mode tự chạy reviewer riêng (xem nhánh bên dưới) → bỏ qua gate cosmetic này
  # tránh log nhầm "coder chạy 1 vòng" cho task find vốn không spawn coder.
  if [[ "$mode" != "find" ]] && ! agent_enabled reviewer; then
    review_enabled=0
    log_skip "reviewer — không nằm trong required_agents (coder chạy 1 vòng, không review)"
  fi

  if [[ "$mode" == "find" ]]; then
    # find: KHÔNG có coder. Reviewer đọc source + plan → trả lời câu hỏi.
    log "$(c_cyan "[2/$step_total]") reviewer (find — đọc source trả lời câu hỏi)"
    local source_summary=""
    [[ -f "$PAGENT_SOURCE/.pagent/source-summary.md" ]] && source_summary="$(cat "$PAGENT_SOURCE/.pagent/source-summary.md")"
    {
      echo "## MODE"; echo "$mode"; echo
      echo "## QUESTION"; echo "$task"; echo
      echo "## REVIEWER_FOCUS"; echo "$reviewer_focus"; echo
      echo "## ORCHESTRATOR_PLAN"; cat "$PAGENT_RUN_DIR/orchestrator.txt"; echo
      echo "## SOURCE_SUMMARY"; echo "$source_summary"
    } | call_agent reviewer >/dev/null || die "reviewer fail"
    verdict="ANSWERED"
  else
  #────── 2·PHA 0. Baseline audit (architecture/performance/security SONG SONG) ──────
  # TRƯỚC khi coder code: các auditor enabled audit baseline SONG SONG → Leader Code
  # (reviewer) chưng CODE_RULES thống nhất, inject vào coder. Chỉ chạy khi review bật +
  # có ≥1 auditor; không auditor → Leader Code review một mình ở PHA 1 (không có RULE).
  rm -f "$PAGENT_RUN_DIR/code_rules.txt"
  if (( review_enabled )) && (( ${#ENABLED_AUDITORS[@]} > 0 )); then
    log "$(c_cyan '[2·pha0]') baseline audit SONG SONG: ${ENABLED_AUDITORS[*]} → Leader Code chưng CODE_RULES"
    local _a _focus _p; local -a _pids=()
    for _a in "${ENABLED_AUDITORS[@]}"; do
      _focus="$(jq -r --arg k "$_a" '.audit_focus[$k] // ""' <<<"$plan_json" 2>/dev/null || true)"
      ( {
          echo "## PHASE"; echo 0; echo
          echo "## MODE"; echo "$mode"; echo
          echo "## TASK"; echo "$task"; echo
          echo "## SOURCE_SUMMARY_PATH"; echo ".pagent/source-summary.md"; echo
          [[ -n "$business_context" ]] && { echo "## BUSINESS_CONTEXT"; echo "$business_context"; echo; }
          [[ -n "$_focus" ]] && { echo "## AUDIT_FOCUS"; echo "$_focus"; }
        } | call_agent "$_a" >/dev/null 2>>"$PAGENT_RUN_DIR/$_a.baseline.err" ) &
      _pids+=($!)
    done
    for _p in "${_pids[@]}"; do wait "$_p" || warn "baseline auditor (pid $_p) fail (tiếp tục)"; done
    log "$(c_cyan '[2·pha0]') Leader Code (reviewer) → CODE_RULES"
    {
      echo "## PHASE"; echo 0; echo
      echo "## MODE"; echo "$mode"; echo
      echo "## TASK"; echo "$task"; echo
      [[ -n "$business_context" ]] && { echo "## BUSINESS_CONTEXT"; echo "$business_context"; echo; }
      [[ -n "$reviewer_focus" ]] && { echo "## REVIEWER_FOCUS"; echo "$reviewer_focus"; echo; }
      for _a in "${ENABLED_AUDITORS[@]}"; do
        case "$_a" in
          architecture) echo "## ARCHITECTURE_REPORT" ;;
          performance)  echo "## PERFORMANCE_REPORT" ;;
          security)     echo "## SECURITY_REPORT" ;;
        esac
        [[ -s "$PAGENT_RUN_DIR/$_a.txt" ]] && cat "$PAGENT_RUN_DIR/$_a.txt" || echo "(auditor $_a không có baseline)"
        echo
      done
    } | call_agent reviewer >/dev/null || warn "Leader Code PHA 0 fail (coder chạy không có CODE_RULES)"
    if [[ -s "$PAGENT_RUN_DIR/reviewer.txt" ]]; then
      cp "$PAGENT_RUN_DIR/reviewer.txt" "$PAGENT_RUN_DIR/code_rules.txt"
      # Đếm luật CHỈ trong block "## CODE_RULES" — không phồng vì bullet trong TRADEOFFS/NOTES.
      local _n_rules; _n_rules="$(awk '/^##[[:space:]]+CODE_RULES/{f=1;next} /^##[[:space:]]/{f=0} f&&/^-[[:space:]]/{c++} END{print c+0}' "$PAGENT_RUN_DIR/code_rules.txt" 2>/dev/null || echo 0)"
      log "  CODE_RULES: $(c_green "$_n_rules luật")"
    fi
  fi

  while (( round <= eff_max_round )) && [[ "$verdict" != "APPROVED" ]]; do
    if (( n_subtasks > 1 && round == 1 )); then
      # Plan lớn: spawn 1 coder cho mỗi subtask độc lập, gộp output → coder.txt.
      # Subtask không đụng cùng file (orchestrator đảm bảo) nên chạy tuần tự an toàn,
      # không lẫn diff. Reviewer chạy 1 lần sau khi gộp.
      # call_agent coder LUÔN overwrite coder.txt (side-effect ghi .result) → tích lũy
      # vào tmp riêng rồi copy 1 lần cuối, tránh mất output các subtask trước.
      log "$(c_cyan "[2/4]") coder round $round — fan-out $n_subtasks subtask độc lập"
      local tmp_coder="$PAGENT_RUN_DIR/coder.tmp"
      : >"$tmp_coder"
      local i sub_id sub_task sub_paths sub_out
      for (( i=0; i<n_subtasks; i++ )); do
        sub_id="$(jq -r ".coder_subtasks[$i].id // \"sub$((i+1))\"" <<<"$plan_json")"
        sub_task="$(jq -r ".coder_subtasks[$i].coder_task // \"\"" <<<"$plan_json")"
        sub_paths="$(jq -r ".coder_subtasks[$i].affected_paths // [] | join(\", \")" <<<"$plan_json")"
        log "  $(c_cyan "[coder:$sub_id]") ${sub_paths:-(no paths)}"
        # Gắn danh tính subtask vào pre/post hook → token log phân biệt được từng subagent,
        # web hiển thị "subtask nào làm gì". Label ưu tiên task; rỗng → affected_paths.
        export PAGENT_SUBTASK_ID="$sub_id" PAGENT_SUBTASK_LABEL="${sub_task:-$sub_paths}"
        sub_out="$( {
          echo "## TASK"; echo "$sub_task"; echo
          [[ -n "$sub_paths" ]] && { echo "## AFFECTED_PATHS"; echo "$sub_paths"; echo; }
          [[ -s "$PAGENT_RUN_DIR/code_rules.txt" ]] && { cat "$PAGENT_RUN_DIR/code_rules.txt"; echo; }
          if [[ -n "$design_spec" ]]; then
            echo "## DESIGN_SPEC"
            echo "Tuân thủ design spec JSON dưới (design tokens, component, layout, accessibility). Dùng token thay vì hardcode màu/spacing."
            echo "$design_spec"; echo
          fi
          echo "## SUBTASK_SCOPE"
          echo "Đây là 1 subtask ĐỘC LẬP trong plan lớn — CHỈ sửa file thuộc AFFECTED_PATHS, KHÔNG động file của subtask khác."
        } | call_agent coder )" || { unset PAGENT_SUBTASK_ID PAGENT_SUBTASK_LABEL; die "coder subtask $sub_id fail"; }
        unset PAGENT_SUBTASK_ID PAGENT_SUBTASK_LABEL
        {
          printf '### Subtask %s — %s\n\n' "$sub_id" "${sub_paths:-(no paths)}"
          printf '%s\n\n' "$sub_out"
        } >>"$tmp_coder"
      done
      cp "$tmp_coder" "$PAGENT_RUN_DIR/coder.txt"
    else
      log "$(c_cyan "[2/4]") coder round $round"
      {
        echo "## TASK"; echo "$coder_input"; echo
        [[ -s "$PAGENT_RUN_DIR/code_rules.txt" ]] && { cat "$PAGENT_RUN_DIR/code_rules.txt"; echo; }
        if [[ -n "$design_spec" ]]; then
          echo "## DESIGN_SPEC"
          echo "Tuân thủ design spec JSON dưới (design tokens, component, layout, accessibility). Dùng token thay vì hardcode màu/spacing."
          echo "$design_spec"; echo
        fi
        if (( round > 1 )); then
          echo "## PREVIOUS_REVIEW"; cat "$PAGENT_RUN_DIR/reviewer.txt"; echo
          echo "## INSTRUCTION"; echo "Fix các điểm BLOCKING/MAJOR ở review trên rồi xuất CHANGES mới."
        fi
      } | call_agent coder >/dev/null || die "coder fail"
    fi

    if (( review_enabled == 0 )); then
      verdict="SKIPPED"   # không review → thoát loop sau khi coder chạy 1 vòng
      break
    fi

    # Snapshot diff 1 LẦN/vòng → mọi auditor SONG SONG + Leader Code cùng `cat` lại (read-only,
    # không đua ghi), bỏ 3× `git diff` chạy song song. Cap head -500 chốt token; nếu bị cắt thì
    # LOG cảnh báo (đừng cắt im lặng) và giữ bản đầy đủ ở diff.full để tra sau.
    local _diff_full="$PAGENT_RUN_DIR/diff.full" _diff_snap="$PAGENT_RUN_DIR/diff.snapshot"
    git_diff_full >"$_diff_full" 2>/dev/null || true
    head -n 500 "$_diff_full" >"$_diff_snap"
    if (( $(wc -l <"$_diff_full") > 500 )); then
      warn "git diff > 500 dòng → cắt còn 500 cho auditor/reviewer (token cap; bản đầy đủ: $_diff_full)"
    fi

    #────── 3·PHA 1. Review diff (auditor SONG SONG) → Leader Code cân đối verdict ──────
    # Auditor enabled review diff SONG SONG (mỗi cái ra VERDICT + FINDINGS), rồi Leader
    # Code (reviewer) tổng hợp thành MỘT verdict cuối, áp CODE_RULES từ PHA 0.
    if (( ${#ENABLED_AUDITORS[@]} > 0 )); then
      log "$(c_cyan "[3/4]") pha1 review diff SONG SONG: ${ENABLED_AUDITORS[*]}"
      local _a _focus _p; local -a _pids=()
      for _a in "${ENABLED_AUDITORS[@]}"; do
        _focus="$(jq -r --arg k "$_a" '.audit_focus[$k] // ""' <<<"$plan_json" 2>/dev/null || true)"
        ( {
            echo "## PHASE"; echo 1; echo
            echo "## MODE"; echo "$mode"; echo
            echo "## ORIGINAL_TASK"; echo "$task"; echo
            [[ -n "$_focus" ]] && { echo "## AUDIT_FOCUS"; echo "$_focus"; echo; }
            [[ -s "$PAGENT_RUN_DIR/code_rules.txt" ]] && { cat "$PAGENT_RUN_DIR/code_rules.txt"; echo; }
            echo "## CODER_OUTPUT"; cat "$PAGENT_RUN_DIR/coder.txt"; echo
            echo "## GIT_DIFF"; cat "$_diff_snap"
          } | call_agent "$_a" >/dev/null 2>>"$PAGENT_RUN_DIR/$_a.err" ) &
        _pids+=($!)
      done
      for _p in "${_pids[@]}"; do wait "$_p" || warn "auditor review (pid $_p) fail (tiếp tục)"; done
    fi

    log "$(c_cyan "[3/4]") Leader Code (reviewer) cân đối verdict (focus: $reviewer_focus)"
    {
      echo "## PHASE"; echo 1; echo
      echo "## MODE"; echo "$mode"; echo
      echo "## ORIGINAL_TASK"; echo "$task"; echo
      echo "## REVIEWER_FOCUS"; echo "$reviewer_focus"; echo
      [[ -s "$PAGENT_RUN_DIR/code_rules.txt" ]] && { cat "$PAGENT_RUN_DIR/code_rules.txt"; echo; }
      if (( ${#ENABLED_AUDITORS[@]} > 0 )); then
        for _a in "${ENABLED_AUDITORS[@]}"; do
          case "$_a" in
            architecture) echo "## ARCHITECTURE_REPORT" ;;
            performance)  echo "## PERFORMANCE_REPORT" ;;
            security)     echo "## SECURITY_REPORT" ;;
          esac
          [[ -s "$PAGENT_RUN_DIR/$_a.txt" ]] && cat "$PAGENT_RUN_DIR/$_a.txt" || echo "(auditor $_a không review)"
          echo
        done
      else
        # Không auditor → Leader Code review một mình trên diff (task nhỏ).
        echo "## CODER_OUTPUT"; cat "$PAGENT_RUN_DIR/coder.txt"; echo
        echo "## GIT_DIFF"; cat "$_diff_snap"
      fi
    } | call_agent reviewer >/dev/null || die "reviewer fail"

    # Verdict parse NEO vào block "## VERDICT" — đọc token trên chính dòng header (dạng
    # "## VERDICT: APPROVED") hoặc dòng non-empty đầu tiên ngay sau nó. KHÔNG grep toàn file:
    # một chữ APPROVED lạc trong CODE_RULES/FINDINGS sẽ tạo verdict PASS giả cho code chưa an
    # toàn. Fail-closed: thiếu block/token → CHANGES_REQUESTED.
    verdict="$(awk '
      /^##[[:space:]]*VERDICT/ { h=$0; sub(/^##[[:space:]]*VERDICT[[:space:]]*:?[[:space:]]*/,"",h);
                                 if (h ~ /(APPROVED|CHANGES_REQUESTED)/) { print h; exit } f=1; next }
      f && NF { print; exit }
    ' "$PAGENT_RUN_DIR/reviewer.txt" | grep -oE 'CHANGES_REQUESTED|APPROVED' | head -1)"
    [[ -n "$verdict" ]] || verdict="CHANGES_REQUESTED"
    log "  verdict round $round: $(c_yellow "$verdict")"
    coder_input="$coder_task"  # giữ task gốc, review sẽ được inject
    round=$((round+1))
  done

  if [[ "$verdict" != "APPROVED" && "$verdict" != "SKIPPED" ]] && (( eff_max_round > 0 )); then
    warn "reviewer chưa APPROVE sau $((round-1)) vòng — vẫn tiếp tục để tester verify"
  fi
  fi  # end mode != find

  #────── 4. Tester (skip toàn bộ khi mode=find — không có code change để test) ──────
  if [[ "$mode" != "find" ]]; then
  # Gating: plan có required_agents → theo list; nếu không → fallback (tester_task hoặc feature).
  local run_tester=0
  if [[ "${PAGENT_GATE}" == "1" ]]; then
    agent_enabled tester && run_tester=1
  elif [[ -n "$tester_task" ]] || [[ "$mode" == "feature" ]]; then
    run_tester=1
  fi
  if (( run_tester && n_tester_subtasks > 1 )); then
    # Plan tách test: spawn 1 tester cho mỗi subtask độc lập, gộp output → tester.txt.
    # Subtask không đụng cùng file (orchestrator đảm bảo) nên chạy tuần tự an toàn.
    # call_agent tester LUÔN overwrite tester.txt (side-effect ghi .result) → tích lũy
    # vào tmp riêng rồi copy 1 lần cuối, tránh mất output các subtask trước.
    log "$(c_cyan '[4/4]') tester — fan-out $n_tester_subtasks subtask độc lập"
    local tmp_tester="$PAGENT_RUN_DIR/tester.tmp"
    : >"$tmp_tester"
    local ti tsub_id tsub_task tsub_paths tsub_out
    for (( ti=0; ti<n_tester_subtasks; ti++ )); do
      tsub_id="$(jq -r ".tester_subtasks[$ti].id // \"tsub$((ti+1))\"" <<<"$plan_json")"
      tsub_task="$(jq -r ".tester_subtasks[$ti].tester_task // \"\"" <<<"$plan_json")"
      tsub_paths="$(jq -r ".tester_subtasks[$ti].affected_paths // [] | join(\", \")" <<<"$plan_json")"
      log "  $(c_cyan "[tester:$tsub_id]") ${tsub_paths:-(no paths)}"
      # Gắn danh tính subtask (như coder fan-out) → web phân biệt từng tester subagent.
      export PAGENT_SUBTASK_ID="$tsub_id" PAGENT_SUBTASK_LABEL="${tsub_task:-$tsub_paths}"
      tsub_out="$( {
        echo "## ORIGINAL_TASK"; echo "$task"; echo
        echo "## TESTER_TASK"; echo "${tsub_task:-Sinh test phù hợp cho thay đổi vừa rồi.}"; echo
        [[ -n "$tsub_paths" ]] && { echo "## AFFECTED_PATHS"; echo "$tsub_paths"; echo; }
        echo "## SUBTASK_SCOPE"
        echo "Đây là 1 subtask test ĐỘC LẬP — CHỈ test trong phạm vi AFFECTED_PATHS, KHÔNG đụng phạm vi của subtask khác."; echo
        echo "## CODER_CHANGES"; cat "$PAGENT_RUN_DIR/coder.txt"
      } | call_agent tester )" || warn "tester subtask $tsub_id fail (tiếp tục)"
      unset PAGENT_SUBTASK_ID PAGENT_SUBTASK_LABEL
      {
        printf '### Subtask %s — %s\n\n' "$tsub_id" "${tsub_paths:-(no paths)}"
        printf '%s\n\n' "$tsub_out"
      } >>"$tmp_tester"
    done
    cp "$tmp_tester" "$PAGENT_RUN_DIR/tester.txt"
  elif (( run_tester )); then
    log "$(c_cyan '[4/4]') tester"
    local tt="${tester_task:-Sinh test phù hợp cho thay đổi vừa rồi.}"
    {
      echo "## ORIGINAL_TASK"; echo "$task"; echo
      echo "## TESTER_TASK"; echo "$tt"; echo
      echo "## CODER_CHANGES"; cat "$PAGENT_RUN_DIR/coder.txt"
    } | call_agent tester >/dev/null || warn "tester fail (tiếp tục)"
  elif [[ "${PAGENT_GATE}" == "1" ]]; then
    log_skip "tester — không nằm trong required_agents"
  else
    log "$(c_dim 'tester skipped (hotfix không cần)')"
  fi
  fi  # end mode != find (tester block)

  #────── 4b. Orchestrator tổng hợp root cause (hotfix only) ──────
  if [[ "$mode" == "hotfix" && -s "$PAGENT_RUN_DIR/reviewer.txt" ]]; then
    log "$(c_cyan '[+]') orchestrator → tổng hợp root cause"
    cp "$PAGENT_RUN_DIR/orchestrator.txt" "$PAGENT_RUN_DIR/orchestrator.plan.txt"  # giữ plan gốc cho report
    local agg_text agg_json root_cause_summary
    agg_text="$( {
      echo "## MODE"; echo "hotfix"; echo
      echo "## INSTRUCTION"
      echo "Đây là bước TỔNG HỢP. Hợp nhất root cause reviewer đề xuất với kết quả test → field root_cause_summary trong JSON output. Giữ nguyên các field plan từ PREVIOUS_PLAN."; echo
      echo "## PREVIOUS_PLAN"; cat "$PAGENT_RUN_DIR/orchestrator.plan.txt"; echo
      echo "## REVIEWER_OUTPUT"; cat "$PAGENT_RUN_DIR/reviewer.txt"; echo
      echo "## TESTER_OUTPUT"
      [[ -s "$PAGENT_RUN_DIR/tester.txt" ]] && cat "$PAGENT_RUN_DIR/tester.txt" || echo "(no tester run)"
    } | call_agent orchestrator )" || warn "orchestrator tổng hợp fail (tiếp tục)"
    cp "$PAGENT_RUN_DIR/orchestrator.plan.txt" "$PAGENT_RUN_DIR/orchestrator.txt"  # khôi phục plan gốc
    agg_json="$(echo "$agg_text" | extract_json 2>/dev/null || true)"
    root_cause_summary="$(jq -r '.root_cause_summary // ""' <<<"$agg_json" 2>/dev/null || true)"
    if [[ -n "$root_cause_summary" ]]; then
      printf '%s\n' "$root_cause_summary" >"$PAGENT_RUN_DIR/root_cause.txt"
      log "  root cause: $(c_green "$root_cause_summary")"
    else
      warn "không trích được root_cause_summary từ orchestrator tổng hợp"
    fi
  fi

  #────── 4d. Docs (CUỐI — sau code merged, khi task thêm/sửa API) ──────
  # Cập nhật swagger/OpenAPI + config setup admin page cho khớp code vừa merged. Scope HẸP:
  # chỉ vùng doc, KHÔNG sửa code sản phẩm. Gating: plan có required_agents → theo list
  # (mirror ENABLED_AUDITORS); gate off → fallback keyword-detect task đụng API. Skip mode=find.
  if [[ "$mode" != "find" && -s "$PAGENT_RUN_DIR/coder.txt" ]]; then
    local want_docs=0
    if [[ "${PAGENT_GATE}" == "1" ]]; then
      agent_enabled docs && want_docs=1
    elif printf '%s\n%s' "$task" "$coder_task" \
           | grep -qiE 'api|endpoint|route|swagger|openapi|rest|admin page|admin config'; then
      want_docs=1
    fi
    if [[ "${PAGENT_GATE}" == "1" && $want_docs -eq 0 ]]; then
      log_skip "docs — không nằm trong required_agents"
    fi
    if (( want_docs )); then
      log "$(c_cyan '[+]') docs → swagger/OpenAPI + admin config"
      local _src_summary=""
      [[ -f "$PAGENT_SOURCE/.pagent/source-summary.md" ]] && _src_summary="$(cat "$PAGENT_SOURCE/.pagent/source-summary.md")"
      {
        echo "## MODE"; echo "$mode"; echo
        echo "## TASK"; echo "$task"; echo
        echo "## CODER_CHANGES"; cat "$PAGENT_RUN_DIR/coder.txt"; echo
        echo "## GIT_DIFF"; git_diff_full; echo
        [[ -n "$_src_summary" ]] && { echo "## SOURCE_SUMMARY"; echo "$_src_summary"; }
      } | call_agent docs >/dev/null || warn "docs fail (tiếp tục không cập nhật swagger/admin)"
    fi
  fi

  #────── 5. Agent orchestration workflow extractor (feature only) ──────
  if [[ "$mode" == "feature" && -f "$PAGENT_RUN_DIR/tester.txt" ]]; then
    log "$(c_cyan '[+]') workflow extractor → agent-workflow.md"
    local wf="$PAGENT_REPORT_DIR/$PAGENT_PROJECT/agent-workflow.md"
    mkdir -p "$(dirname "$wf")"
    _init_wf() { [[ -f "$wf" ]] || printf '# Agent Orchestration Workflow — %s\n\n' "$PAGENT_PROJECT" >"$wf"; }
    with_lock "$wf" _init_wf

    {
      echo "## FEATURE_TITLE"; echo "$title"; echo
      echo "## TASK"; echo "$task"; echo
      echo "## CODER_CHANGES"; cat "$PAGENT_RUN_DIR/coder.txt"; echo
      echo "## TESTS_ADDED"; cat "$PAGENT_RUN_DIR/tester.txt"; echo
      echo "## REPORT_HISTORY"
      local _rf _rn=0
      for _rf in $(ls -1t "$PAGENT_REPORT_DIR/$PAGENT_PROJECT/features/"*.md \
                          "$PAGENT_REPORT_DIR/$PAGENT_PROJECT/bugs/"*.md 2>/dev/null); do
        [[ -e "$_rf" ]] || continue
        (( _rn++ >= 40 )) && break   # cap để tránh input quá dài
        printf '\n### %s\n' "${_rf#"$PAGENT_REPORT_DIR/$PAGENT_PROJECT/"}"
        cat "$_rf"
      done
      [[ "$_rn" -eq 0 ]] && echo "(chưa có report history)"
      echo
      echo "## PROJECT_PROMPT"
      if [[ -f "$PAGENT_SOURCE/.pagent/source-summary.md" ]]; then
        cat "$PAGENT_SOURCE/.pagent/source-summary.md"
      else
        echo "(không có source-summary.md)"
      fi
      echo
      echo "## EXISTING_WORKFLOW_PATH"; echo "$wf"
    } | call_agent workflow-extractor >/dev/null || warn "workflow extractor fail"
  fi

  #────── 6. Báo cáo + auto compact ──────
  local report_subdir
  case "$mode" in
    feature) report_subdir="features" ;;
    hotfix)  report_subdir="bugs" ;;
    chore)   report_subdir="chores" ;;
    find)    report_subdir="findings" ;;
  esac
  local report_dir="$PAGENT_REPORT_DIR/$PAGENT_PROJECT/$report_subdir"
  mkdir -p "$report_dir"
  local date_str; date_str="$(date -u +%Y-%m-%d)"
  local report_file="$report_dir/$date_str-$PAGENT_TASK_ID.md"

  write_report "$report_file" "$title" "$task" "$risk" "$affected"
  log "$(c_green 'Report:') $report_file"

  #────── 5c. Decision log (ADR) — feature/hotfix: append 1 quyết định vào knowledge ──────
  # Append-only log. Gate PAGENT_KNOWLEDGE (mặc định bật). Cần coder.txt làm RATIONALE.
  if { [[ "$mode" == "feature" || "$mode" == "hotfix" ]]; } && _is_truthy "${PAGENT_KNOWLEDGE:-1}" \
     && [[ -s "$PAGENT_RUN_DIR/coder.txt" ]]; then
    log "$(c_cyan '[+]') decision-log → knowledge/decisions.md"
    local kdir="$PAGENT_SOURCE/.pagent/knowledge"; mkdir -p "$kdir"
    local ref_rel="${report_file#"$PAGENT_REPORT_DIR/$PAGENT_PROJECT/"}"
    {
      echo "## DECISION_DATE"; echo "$date_str"; echo
      echo "## DECISION_TITLE"; echo "$title"; echo
      echo "## TASK"; echo "$task"; echo
      echo "## RATIONALE"; cat "$PAGENT_RUN_DIR/coder.txt"; echo
      echo "## REF"; echo "$ref_rel"; echo
      echo "## EXISTING_DECISIONS_PATH"; echo "$kdir/decisions.md"
    } | call_agent decision-log >/dev/null || warn "decision-log fail (tiếp tục)"
  fi

  # Auto-compact: gộp tóm tắt vào CHANGELOG-style, giữ run_dir nhưng nén
  ( cd "$PAGENT_RUN_DIR" && tar czf bundle.tar.gz ./*.json ./*.txt ./*.err 2>/dev/null && \
    find . -maxdepth 1 -type f \( -name '*.json' -o -name '*.err' \) -delete ) || true
  log "$(c_dim "compacted: $PAGENT_RUN_DIR/bundle.tar.gz")"

  # Summary
  printf '\n%s\n' "$(c_green '═══ DONE ═══')"
  printf '  title:   %s\n' "$title"
  printf '  verdict: %s\n' "$verdict"
  [[ -s "$PAGENT_RUN_DIR/root_cause.txt" ]] && printf '  root cause: %s\n' "$(cat "$PAGENT_RUN_DIR/root_cause.txt")"
  printf '  affected: %s\n' "$affected"
  printf '  report:  %s\n' "$report_file"
}

cmd_report() {
  local proj="${1:-$PAGENT_PROJECT}"
  local root="$PAGENT_REPORT_DIR/$proj"
  [[ -d "$root" ]] || die "chưa có report cho project: $proj"

  printf '%s\n' "$(c_green "═══ $proj ═══")"
  for sub in features bugs; do
    local d="$root/$sub"
    [[ -d "$d" ]] || continue
    printf '\n%s:\n' "$(c_cyan "$sub")"
    ls -1t "$d"/*.md 2>/dev/null | head -20 | while read -r f; do
      local title; title="$(head -1 "$f" | sed 's/^# //')"
      printf '  %s  %s\n' "$(basename "$f" .md)" "$title"
    done
  done

  printf '\n%s:\n' "$(c_cyan 'cost by date')"
  for f in "$root/tokens/"*.jsonl; do
    [[ -f "$f" ]] || continue
    local d; d="$(basename "$f" .jsonl)"
    local total; total="$(jq -s '[.[]|select(.event=="end")|.cost_usd]|add // 0' "$f")"
    printf '  %s  $%.4f\n' "$d" "$total"
  done

  printf '\n%s:\n' "$(c_cyan 'cost by task (today)')"
  local today; today="$(date -u +%Y-%m-%d)"
  if [[ -f "$root/tokens/$today.jsonl" ]]; then
    jq -s --arg t "$today" '
      [.[]|select(.event=="end")] | group_by(.task_id) | map({
        task_id: .[0].task_id,
        mode: .[0].mode,
        agents: (length),
        cost: (map(.cost_usd)|add)
      }) | .[] | "  \(.task_id)  \(.mode)  agents=\(.agents)  $\(.cost)"
    ' -r "$root/tokens/$today.jsonl"
  else
    echo "  (chưa có hoạt động hôm nay)"
  fi
}

cmd_skills() {
  printf '%s\n' "$(c_green '═══ Project-local ═══') ($PAGENT_SOURCE/.pagent/)"
  for sub in skills agents; do
    local d="$PAGENT_SOURCE/.pagent/$sub"
    [[ -d "$d" ]] || continue
    for f in "$d"/*.md; do
      [[ -f "$f" ]] || continue
      local n; n="$(md_meta "$f" name)"; [[ -z "$n" ]] && n="$(basename "$f" .md)"
      printf '  %-8s %-20s %s\n' "$sub" "$n" "$(md_meta "$f" description)"
    done
  done
  printf '\n%s\n' "$(c_green '═══ Global (kit/) ═══') ($KIT_DIR)"
  for sub in skills agents; do
    for f in "$KIT_DIR/$sub/"*.md; do
      [[ -f "$f" ]] || continue
      local n; n="$(md_meta "$f" name)"; [[ -z "$n" ]] && n="$(basename "$f" .md)"
      local overridden=""
      [[ -f "$PAGENT_SOURCE/.pagent/$sub/$(basename "$f")" ]] && overridden=" $(c_dim '(overridden)')"
      printf '  %-8s %-20s %s%s\n' "$sub" "$n" "$(md_meta "$f" description)" "$overridden"
    done
  done
}

cmd_skill_new() {
