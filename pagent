  PAGENT_CLAUDE_MODEL       model tên trần cho provider claude (mặc định sonnet; việc
                            cực lớn → opus). Web settings per-project set biến này.
  PAGENT_MAX_REVIEW_ROUND   số vòng coder↔review DÙNG CHUNG (mặc định 2); reviewer.md có thể
                            override qua frontmatter max_review_round (Leader Code giữ ngân sách chung)
  PAGENT_MAX_TURNS          override max_turns mọi agent (repo lớn → tăng để tránh max_turns fail)
  PAGENT_MAX_TURNS_<AGENT>  override riêng 1 agent, vd PAGENT_MAX_TURNS_ORCHESTRATOR=40
  PAGENT_CONFIRM            1 → bắt buộc xác nhận plan trước khi chạy agent (web tự bật)
  PAGENT_CONFIRM_TIMEOUT    giây chờ xác nhận qua web rồi hủy (mặc định 1800)
  PAGENT_RESUME             1 → agent cạn max_turns thì DỪNG CHỜ cấp thêm lượt (button Resume
                            trên web Live) rồi tiếp tục ĐÚNG session; 0 → tắt cả tty prompt.
                            Non-tty không bật → fail ngay như cũ. Web spawn tự bật.
  PAGENT_RESUME_TIMEOUT     giây chờ quyết định resume rồi fail như cũ (mặc định 900)
  PAGENT_MAX_RESUME         số vòng resume tối đa mỗi agent mỗi run (mặc định 3)
  PAGENT_YES / PAGENT_NO_CONFIRM  1 → bỏ qua gate xác nhận (vẫn in plan summary), chạy luôn
  PAGENT_CAVEMAN            off|lite|full|ultra — token compress mode (override md frontmatter)
  PAGENT_KNOWLEDGE          1 (mặc định) → bật context-planning bước [0] + decision-log; 0 → tắt
  PAGENT_OPENROUTER_KEY     OpenRouter API key (sk-or-v1-…) cho fallback khi Claude down
  PAGENT_OPENROUTER_BASE    default: https://openrouter.ai/api/v1
  PAGENT_PROVIDER           claude|openrouter — ép provider toàn pipeline
  PAGENT_KIT_DIR            override kit/ folder

PIPELINE
  Tầng review = architecture‖performance‖security chạy SONG SONG (2 pha) + Leader Code (reviewer):
    PHA 0 (trước coder): auditor audit baseline SONG SONG → Leader Code chưng CODE_RULES thống nhất → inject vào coder
    PHA 1 (trên diff):   auditor review diff SONG SONG → Leader Code cân đối 3 verdict → 1 verdict cuối
  Orchestrator điều phối QUA Leader Code — không gọi trực tiếp coder/auditor.
  Auditor nào chạy = required_agents (orchestrator chọn theo bản chất task); auditor bất kỳ → luôn kèm reviewer.
  DevOps (devops): chạy SỚM (init/thiếu file Dockerfile/compose/.gitlab-ci) — sinh hạ tầng + chốt env .env.pagent/.env.pagent.example, TRƯỚC coder.
  Docs (docs): chạy CUỐI (sau code merged, gần workflow-extractor) — cập nhật swagger/OpenAPI + admin config khi task thêm/sửa API. Scope hẹp, KHÔNG sửa code.
  feature: context-planning[0] → orchestrator → (designer) → (devops) → [PHA0 audit‖ → CODE_RULES] → coder → [PHA1 audit‖ → verdict] (loop) → tester → (docs) → workflow-extractor → decision-log
  hotfix:  context-planning[0] → orchestrator → (devops) → [PHA0 audit‖ → CODE_RULES] → coder → [PHA1 audit‖ → verdict+root cause] (loop) → tester regression → (docs) → orchestrator (root cause) → decision-log
  chore:   orchestrator → coder → [PHA1 audit‖ →] Leader Code review (loop)  [tester nếu plan yêu cầu; KHÔNG workflow-extractor]
  find:    orchestrator → Leader Code (read-only, đọc source trả lời câu hỏi — KHÔNG coder/auditor/tester)
  Pre/post hook → ghi token+cost vào tokens/<date>.jsonl
  Auto-compact run dir → bundle.tar.gz

OUTPUT TREE
  $PAGENT_REPORT_DIR/<project>/
    ├── features/<date>-<taskid>.md
    ├── bugs/<date>-<taskid>.md
    ├── chores/<date>-<taskid>.md
    ├── findings/<date>-<taskid>.md
    ├── workflow.md
    ├── tokens/<date>.jsonl
    └── runs/<taskid>/bundle.tar.gz
EOF
}

#─────────────────────────────────────────────
# Dispatch
#─────────────────────────────────────────────
cmd="${1:-help}"; shift || true
case "$cmd" in
  init)      cmd_init ;;
  feat|feature)   cmd_pipeline feature "${*:-}" ;;
  fix|bug|hotfix) cmd_pipeline hotfix "${*:-}" ;;
  chore)          cmd_pipeline chore "${*:-}" ;;
  find|query)     cmd_pipeline find "${*:-}" ;;
  report)    cmd_report "${1:-}" ;;
  workflow)  cmd_workflow "$@" ;;
  knowledge) cmd_knowledge "$@" ;;
  env)       cmd_env ;;
  web)
    port="${1:-8765}"; host="${2:-127.0.0.1}"
    [[ -f "$KIT_DIR/web/server.py" ]] || die "kit/web/server.py missing"
    need python3
    log "$(c_cyan 'dashboard:') http://$host:$port  (reports: $PAGENT_REPORT_DIR)"
    PORT="$port" HOST="$host" PAGENT_REPORT_DIR="$PAGENT_REPORT_DIR" \
      exec python3 "$KIT_DIR/web/server.py"
    ;;
  gain)
    if ! command -v rtk >/dev/null; then die "rtk chưa cài"; fi
    if [[ "${1:-}" == "-w" || "${1:-}" == "--watch" ]]; then
      cmd="rtk gain --project; echo; rtk gain -H | head -10"
      if command -v watch >/dev/null; then watch -n 3 "$cmd"
      else while true; do clear; eval "$cmd"; sleep 3; done; fi
    else
      rtk gain --project
    fi
    ;;
  skills|agents) cmd_skills ;;
  skill)
    case "${1:-}" in
      new) shift; cmd_skill_new skill "$@" ;;
      *)   cmd_skills ;;
    esac
    ;;
  agent)
    case "${1:-}" in
      new) shift; cmd_skill_new agent "$@" ;;
      *)   cmd_skills ;;
    esac
    ;;
  -h|--help|help|"") cmd_help ;;
  *)
    # Fallback theo $PAGENT_MODE
    if [[ -n "${PAGENT_MODE:-}" ]]; then
      cmd_pipeline "$PAGENT_MODE" "$cmd $*"
    else
      die "lệnh không biết: $cmd  (chạy: pagent help)"
    fi
    ;;
esac
