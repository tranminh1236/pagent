#!/usr/bin/env bash
# pagent — orchestrator dùng claude CLI làm backend
# Tầng review: architecture‖performance‖security chạy SONG SONG (2 pha), Leader Code
# (reviewer) chưng CODE_RULES ở PHA 0 + cân đối verdict ở PHA 1. Orchestrator điều phối
# QUA Leader Code — không gọi trực tiếp coder/auditor.
# Flow feature: orchestrator → (devops) → [PHA0 audit‖ → Leader Code=CODE_RULES] → coder → [PHA1 audit‖ → Leader Code verdict] (loop) → tester → (docs) → workflow extractor
# Flow hotfix:  orchestrator → (devops) → [PHA0 audit‖ → CODE_RULES] → coder → [PHA1 audit‖ → verdict+root cause] (loop) → tester regression → (docs)
# Reports:      $PAGENT_REPORT_DIR/<project>/{features,bugs}/<date>-<taskid>.md
# Tokens:       $PAGENT_REPORT_DIR/<project>/tokens/<date>.jsonl
set -euo pipefail

#─────────────────────────────────────────────
# Locate kit
#─────────────────────────────────────────────
_src="${BASH_SOURCE[0]}"; while [[ -L "$_src" ]]; do _src="$(readlink "$_src")"; done
SCRIPT_DIR="$(cd "$(dirname "$_src")" && pwd)"
KIT_DIR="${PAGENT_KIT_DIR:-$SCRIPT_DIR/kit}"

# Portable file lock (flock/mkdir) — chống interleave khi chạy song song
if [[ -f "$KIT_DIR/lib/lock.sh" ]]; then . "$KIT_DIR/lib/lock.sh"; else with_lock() { shift; "$@"; }; fi
# Resume gate khi agent chạm max_turns (xem call_agent). Thiếu lib → gate off êm.
if [[ -f "$KIT_DIR/lib/resume.sh" ]]; then . "$KIT_DIR/lib/resume.sh"; else resume_gate() { return 1; }; fi

#─────────────────────────────────────────────
# Auto-load .env.pagent từ cwd hoặc parents
#─────────────────────────────────────────────
load_env() {
  local d="$PWD"
  while [[ "$d" != "/" ]]; do
    if [[ -f "$d/.env.pagent" ]]; then
      set -a && . "$d/.env.pagent" && set +a
      return
    fi
    d="$(dirname "$d")"
  done
}
load_env

# Auto-detect source folder (ưu tiên git toplevel, fallback $PWD)
detect_source() {
  local root
  if root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    echo "$root"
  else
    echo "$PWD"
  fi
}
PAGENT_SOURCE="${PAGENT_SOURCE:-$(detect_source)}"
PAGENT_PROJECT="${PAGENT_PROJECT:-$(basename "$PAGENT_SOURCE")}"
PAGENT_REPORT_DIR="${PAGENT_REPORT_DIR:-$HOME/.pagent-reports}"
# PAGENT_MODEL dạng provider/model của opencode (vd "9router/Claude"). Rỗng → opencode
# dùng model default trong config (~/.config/opencode/opencode.json). Nhánh claude ẩn
# tự fallback "sonnet" nội bộ.
PAGENT_MODEL="${PAGENT_MODEL:-}"
PAGENT_CLAUDE_BIN="${PAGENT_CLAUDE_BIN:-claude}"
# Provider claude = việc LỚN đi thẳng subscription Anthropic (mặc định direct: gỡ
# ANTHROPIC_BASE_URL/API_KEY khi invoke — không dính gateway). Model tên trần.
PAGENT_CLAUDE_DIRECT="${PAGENT_CLAUDE_DIRECT:-1}"
PAGENT_CLAUDE_MODEL="${PAGENT_CLAUDE_MODEL:-sonnet}"
PAGENT_OPENCODE_BIN="${PAGENT_OPENCODE_BIN:-opencode}"
# XDG home riêng cho opencode do pagent spawn: né ~/.local/share|state / ~/.cache/opencode
# bị root chiếm (di sản chạy sudo) + cô lập session pagent khỏi opencode dùng tay.
PAGENT_OC_HOME="${PAGENT_OC_HOME:-$PAGENT_REPORT_DIR/.opencode}"
# opencode không có max_turns → guard treo bằng trần thời gian 1 lượt agent (giây).
PAGENT_AGENT_TIMEOUT="${PAGENT_AGENT_TIMEOUT:-3600}"
PAGENT_MAX_REVIEW_ROUND="${PAGENT_MAX_REVIEW_ROUND:-2}"
PAGENT_OPENROUTER_BASE="${PAGENT_OPENROUTER_BASE:-https://openrouter.ai/api/v1}"
PAGENT_OPENROUTER_KEY="${PAGENT_OPENROUTER_KEY:-${OPENROUTER_API_KEY:-}}"

#─────────────────────────────────────────────
# Utils
#─────────────────────────────────────────────
c_dim()   { printf '\033[90m%s\033[0m' "$*"; }
c_cyan()  { printf '\033[36m%s\033[0m' "$*"; }
c_green() { printf '\033[32m%s\033[0m' "$*"; }
c_yellow(){ printf '\033[33m%s\033[0m' "$*"; }
c_red()   { printf '\033[31m%s\033[0m' "$*"; }
log()  { printf '%s %s\n' "$(c_cyan '›')" "$*" >&2; }
warn() { printf '%s %s\n' "$(c_yellow '⚠')" "$*" >&2; }
die()  { printf '%s %s\n' "$(c_red 'error:')" "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "thiếu công cụ: $1"; }
need jq
# Binary backend check lazy theo provider trong call_agent — backend mặc định là
# opencode; claude/openrouter là provider phụ, chỉ cần binary khi thật sự dùng.

# YAML frontmatter parse
md_body() {
  awk 'BEGIN{p=0} /^---$/{p++; next} p>=2 || (p==0 && NR>1){print}' "$1"
}
md_meta() {
  awk -v k="$2" '
    /^---$/{p++; next}
    p==1 && $1==k":" { sub("^[^:]+:[[:space:]]*",""); print; exit }
  ' "$1"
}

# date giây + PID + random → tách biệt tuyệt đối giữa các run song song
# ($$ loại bỏ xác suất trùng khi 2 process khởi tạo trong cùng 1 giây trùng random)
new_task_id() { printf '%s-%s-%s' "$(date -u +%Y%m%dT%H%M%S)" "$$" "$(jot -r 1 1000 9999 2>/dev/null || echo $RANDOM)"; }

# Agent gating — orchestrator chỉ định `required_agents`; dispatcher skip agent ngoài list.
# PAGENT_GATE=1 → bật gating; =0 → mọi agent enabled (backward-compat khi field thiếu/parse lỗi).
# PAGENT_REQUIRED_AGENTS = list cách nhau khoảng trắng (vd " coder reviewer tester ").
agent_enabled() {
  [[ "${PAGENT_GATE:-0}" == "1" ]] || return 0
  [[ " ${PAGENT_REQUIRED_AGENTS:-} " == *" $1 "* ]]
}
# Log skip rõ ràng: prefix text "[skip]" là tín hiệu chính, màu chỉ phụ trợ.
log_skip() { printf '%s %s\n' "$(c_yellow '[skip]')" "$*" >&2; }

# Resolve md path của 1 agent (project-local override global — cùng thứ tự call_agent).
# Stdout: path. Exit 1 nếu không tìm thấy.
resolve_agent_md() {
  local agent="$1" cand
  for cand in \
    "$PAGENT_SOURCE/.pagent/skills/$agent.md" \
    "$PAGENT_SOURCE/.pagent/agents/$agent.md" \
    "$KIT_DIR/skills/$agent.md" \
    "$KIT_DIR/agents/$agent.md"; do
    [[ -f "$cand" ]] && { printf '%s' "$cand"; return 0; }
  done
  return 1
}
# Đọc 1 field frontmatter của agent (resolve md trước). Rỗng nếu thiếu md/field.
agent_meta() { local md; md="$(resolve_agent_md "$1")" || return 0; md_meta "$md" "$2"; }

# Phát hiện plugin Superpowers của claude CLI (chứa skill brainstorming + writing-plans).
# Im lặng, KHÔNG lỗi nếu thiếu — echo "1" khi có CẢ 2 skill, ngược lại "0".
# Chỉ có nghĩa với provider=claude (Superpowers là plugin claude CLI); provider khác → "0".
# Quét các thư mục plugin chuẩn của claude; tìm thư mục skill dưới một plugin tên *superpowers*.
detect_superpowers() {
  local provider="${1:-claude}"
  [[ "$provider" == "claude" ]] || { echo 0; return 0; }
  local roots=(
    "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins"
    "$HOME/.claude/plugins"
  )
  local root
  for root in "${roots[@]}"; do
    [[ -d "$root" ]] || continue
    if find "$root" -maxdepth 6 -type d -ipath '*superpowers*/skills/brainstorming'  2>/dev/null | grep -q . \
    && find "$root" -maxdepth 6 -type d -ipath '*superpowers*/skills/writing-plans'  2>/dev/null | grep -q .; then
      echo 1; return 0
    fi
  done
  echo 0
}

# Phát hiện skill TDD của plugin Superpowers (chứa skill test-driven-development).
# Im lặng, KHÔNG lỗi nếu thiếu — echo "1" khi có skill, ngược lại "0".
# Chỉ có nghĩa với provider=claude (Superpowers là plugin claude CLI); provider khác → "0".
detect_superpowers_tdd() {
  local provider="${1:-claude}"
  [[ "$provider" == "claude" ]] || { echo 0; return 0; }
  local roots=(
    "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins"
    "$HOME/.claude/plugins"
  )
  local root
  for root in "${roots[@]}"; do
    [[ -d "$root" ]] || continue
    if find "$root" -maxdepth 6 -type d -ipath '*superpowers*/skills/test-driven-development' 2>/dev/null | grep -q .; then
      echo 1; return 0
    fi
  done
  echo 0
}

# Gọi OpenRouter /chat/completions, transform response → format giống claude CLI JSON
# Stdin: user prompt. Args: $1=model $2=system_prompt $3=resp_file
call_openrouter() {
  local model="$1" system_prompt="$2" resp_file="$3"
  local prompt; prompt="$(cat)"
  [[ -n "$PAGENT_OPENROUTER_KEY" ]] || { echo "OPENROUTER_API_KEY required" >&2; return 1; }

  local body t_start t_end dur_ms raw
  body="$(jq -n --arg sp "$system_prompt" --arg up "$prompt" --arg m "$model" \
    --argjson usage_acc 'true' '{
      model: $m,
      messages: [{role:"system",content:$sp},{role:"user",content:$up}],
      usage: {include: true}
    }')"
  t_start="$(python3 -c 'import time;print(int(time.time()*1000))')"
  raw="$(curl -sS -X POST "$PAGENT_OPENROUTER_BASE/chat/completions" \
    -H "Authorization: Bearer $PAGENT_OPENROUTER_KEY" \
    -H "HTTP-Referer: https://github.com/local/pagent" \
    -H "X-Title: pagent" \
    -H "Content-Type: application/json" \
    --data-binary @- <<<"$body")"
  t_end="$(python3 -c 'import time;print(int(time.time()*1000))')"
  dur_ms=$((t_end - t_start))

  # Transform: OpenRouter chat completion → claude CLI shape (cho post.sh)
  jq -n --argjson r "$raw" --arg dur "$dur_ms" --arg m "$model" '
    {
      type: "result",
      subtype: (if $r.error then "error" else "success" end),
      is_error: ($r.error != null),
      result:   ($r.choices[0].message.content // ""),
      session_id: ($r.id // ""),
      duration_ms: ($dur | tonumber),
      total_cost_usd: ($r.usage.cost // 0),
      usage: {
        input_tokens:                ($r.usage.prompt_tokens // 0),
        output_tokens:               ($r.usage.completion_tokens // 0),
        cache_read_input_tokens:     ($r.usage.prompt_tokens_details.cached_tokens // 0),
        cache_creation_input_tokens: 0
      },
      modelUsage: { ($r.model // $m): {
        inputTokens:              ($r.usage.prompt_tokens // 0),
        outputTokens:             ($r.usage.completion_tokens // 0),
        cacheReadInputTokens:     ($r.usage.prompt_tokens_details.cached_tokens // 0),
        cacheCreationInputTokens: 0,
        costUSD:                  ($r.usage.cost // 0)
      } },
      terminal_reason: (if $r.error then ($r.error.message // "error") else "completed" end),
      provider: "openrouter"
    }
  ' >"$resp_file"
}

# Sinh agent file opencode từ agent md của kit — .opencode/agents/pagent-<agent>.md
# (opencode đọc theo project dir). Body = system prompt SAU mọi injection (caveman/TDD).
# permission map thô từ allowed/disallowed_tools: Write|Edit → edit, Bash → bash,
# WebFetch → webfetch (mất allow-list chi tiết kiểu `Bash(cat *)` — chấp nhận theo spec).
# Args: $1=agent $2=system_prompt $3=allowed $4=disallowed
oc_agent_file() {
  local agent="$1" system_prompt="$2" allowed="$3" disallowed="$4"
  local dir="$PAGENT_SOURCE/.opencode/agents"
  mkdir -p "$dir"
  local p_edit=deny p_bash=deny p_webfetch=deny
  [[ "$allowed" == *Write* || "$allowed" == *Edit* ]] && p_edit=allow
  [[ "$disallowed" == *Write* || "$disallowed" == *Edit* ]] && p_edit=deny
  [[ "$allowed" == *Bash* ]] && p_bash=allow
  [[ "$disallowed" == *Bash* ]] && p_bash=deny
  [[ "$allowed" == *WebFetch* || "$allowed" == *webfetch* ]] && p_webfetch=allow
  cat >"$dir/pagent-$agent.md" <<EOF
---
description: pagent agent '$agent' (auto-generated mỗi run — đừng sửa tay, thêm .opencode/agents/pagent-*.md vào .gitignore)
mode: primary
permission:
  edit: $p_edit
  bash: $p_bash
  webfetch: $p_webfetch
---
$system_prompt
EOF
}

# Sinh MCP config opencode từ kit/mcp/*.json (dạng claude {mcpServers}) → merge vào
# $PAGENT_SOURCE/.opencode/opencode.json key `mcp`. CHỈ ghi khi file chưa tồn tại hoặc
# do pagent sinh (marker _pagent_generated) — không clobber config opencode riêng của user.
# Args: các path kit/mcp/*.json
oc_mcp_config() {
  local out="$PAGENT_SOURCE/.opencode/opencode.json"
  if [[ -f "$out" ]] && ! jq -e '._pagent_generated == true' "$out" >/dev/null 2>&1; then
    warn "$out là config user tự quản — bỏ qua sinh mcp (tự thêm server vào đó nếu cần)"
    return 0
  fi
  mkdir -p "$PAGENT_SOURCE/.opencode"
  # claude http server → opencode remote {type:"remote",url}; stdio {command,args} →
  # local {type:"local",command:[...]}
  jq -s '
    {_pagent_generated: true,
     mcp: (map(.mcpServers | to_entries) | add | map({
       key: .key,
       value: (if .value.url then {type: "remote", url: .value.url}
               else {type: "local",
                     command: ([.value.command] + (.value.args // [])),
                     environment: (.value.env // {})} end)
     }) | from_entries)}
  ' "$@" >"$out"
}

# Gọi opencode CLI (backend MẶC ĐỊNH), transform NDJSON events → format claude CLI JSON
# (post.sh/web/_resp_ok dùng chung 1 shape cho mọi provider).
# Stdin: user prompt. Args: $1=agent $2=model ("" → default config opencode) $3=resp_file
# Env: PAGENT_RUN_DIR (events + err ghi cạnh resp), PAGENT_OC_HOME, PAGENT_AGENT_TIMEOUT
call_opencode() {
  local agent="$1" model="$2" resp_file="$3"
  local prompt; prompt="$(cat)"
  local ev_file="$PAGENT_RUN_DIR/$agent.oc.jsonl"

  mkdir -p "$PAGENT_OC_HOME/data" "$PAGENT_OC_HOME/state" "$PAGENT_OC_HOME/cache"
  local oc_args=(run --dir "$PAGENT_SOURCE" --format json --auto \
                 --title "pagent-$PAGENT_TASK_ID-$agent" --agent "pagent-$agent")
  [[ -n "$model" ]] && oc_args+=(-m "$model")

  local t_start t_end dur_ms rc=0
  t_start="$(python3 -c 'import time;print(int(time.time()*1000))')"
  # alarm = trần thời gian 1 lượt (opencode không có max_turns). Prompt qua argv
  # (message positional của opencode run) — trần ARG_MAX ~256KB, lỗi spawn sẽ lộ rõ.
  XDG_DATA_HOME="$PAGENT_OC_HOME/data" XDG_STATE_HOME="$PAGENT_OC_HOME/state" \
  XDG_CACHE_HOME="$PAGENT_OC_HOME/cache" \
    perl -e 'alarm shift @ARGV; exec @ARGV or die "exec fail: $!"' -- \
    "$PAGENT_AGENT_TIMEOUT" "$PAGENT_OPENCODE_BIN" "${oc_args[@]}" "$prompt" \
    >"$ev_file" 2>>"$PAGENT_RUN_DIR/$agent.err" </dev/null || rc=$?
  t_end="$(python3 -c 'import time;print(int(time.time()*1000))')"
  dur_ms=$((t_end - t_start))

  # Transform events → claude shape. .result = text event CUỐI (response chốt của agent);
  # lỗi → nhét message vào .result để nhánh fail warn đúng reason (xem _resp_ok).
  jq -s --argjson rc "$rc" --argjson dur "$dur_ms" --arg m "${model:-opencode/default}" '
    (map(select(.type == "text")) | if length > 0 then last.part.text else null end) as $text
    | [.[] | select(.type == "step_finish").part] as $steps
    | (map(select(.type == "error")) | if length > 0 then last.error else null end) as $err
    | (($err != null) or ($rc != 0)) as $bad
    | {
        type: "result",
        subtype: (if $bad then "error" else "success" end),
        is_error: $bad,
        result: (if $bad
                 then (($err.data.message // $err.name // "opencode fail rc=\($rc)"))
                 else ($text // "") end),
        session_id: ((map(.sessionID) | map(select(. != null)) | first) // ""),
        num_turns: ($steps | length),
        duration_ms: $dur,
        total_cost_usd: ([$steps[].cost // 0] | add // 0),
        usage: {
          input_tokens:                ([$steps[].tokens.input // 0] | add // 0),
          output_tokens:               ([$steps[].tokens.output // 0] | add // 0),
          cache_read_input_tokens:     ([$steps[].tokens.cache.read // 0] | add // 0),
          cache_creation_input_tokens: ([$steps[].tokens.cache.write // 0] | add // 0)
        },
        modelUsage: { ($m): {
          inputTokens:              ([$steps[].tokens.input // 0] | add // 0),
          outputTokens:             ([$steps[].tokens.output // 0] | add // 0),
          cacheReadInputTokens:     ([$steps[].tokens.cache.read // 0] | add // 0),
          cacheCreationInputTokens: ([$steps[].tokens.cache.write // 0] | add // 0),
          costUSD:                  ([$steps[].cost // 0] | add // 0)
        } },
        terminal_reason: (if $bad then (($err.data.message // $err.name // "error")) else "completed" end),
        provider: "opencode"
      }
  ' "$ev_file" >"$resp_file" 2>>"$PAGENT_RUN_DIR/$agent.err" \
    || printf '{"type":"result","subtype":"error","is_error":true,"result":"opencode events parse fail (rc=%s) — xem %s","provider":"opencode"}\n' \
         "$rc" "$ev_file" >"$resp_file"
}

# Trích JSON object đầu tiên hợp lệ từ text bất kỳ (xử lý fence, preamble, postamble).
# Stdin: text thô. Stdout: JSON. Exit 0 nếu thành công.
extract_json() {
  python3 -c '
import sys, re, json
t = sys.stdin.read()
# strict=False: chấp nhận control char thô (vd newline literal trong flow_diagram —
# model thường quên escape \n). Luôn RE-SERIALIZE bằng json.dumps để output là JSON
# canonical hợp lệ strict (escape \n đúng) → downstream jq (strict theo spec) parse được.
def emit(o):
    sys.stdout.write(json.dumps(o, ensure_ascii=False)); sys.exit(0)
try: emit(json.loads(t, strict=False))
except Exception: pass
s = re.sub(r"^```\w*\s*", "", t.strip(), flags=re.M)
s = re.sub(r"\s*```$", "", s, flags=re.M)
try: emit(json.loads(s, strict=False))
except Exception: pass
def fb(s):
    i = s.find("{")
    while i >= 0:
        d=0; ins=False; esc=False
        for j in range(i, len(s)):
            c = s[j]
            if esc: esc=False; continue
            if c=="\\": esc=True; continue
            if c==chr(34): ins=not ins; continue
            if ins: continue
            if c=="{": d+=1
            elif c=="}":
                d-=1
                if d==0: return s[i:j+1]
        i = s.find("{", i+1)
    return None
c = fb(t)
if c:
    try: emit(json.loads(c, strict=False))
    except Exception: pass
sys.exit(1)
'
}

# Spinner: chạy nền trong khi đợi $1=pid, in "$2" làm label. Tự đếm thời gian.
spinner() {
  local pid="$1" label="$2"
  local frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
  local i=0 start; start="$(date +%s)"
  # Tắt nếu stderr không phải tty
  [[ ! -t 2 ]] && { wait "$pid" 2>/dev/null; return; }
  # Lưu trap EXIT hiện có (vd release_run_lock) để KHÔI PHỤC, không xoá trắng.
  local _old_exit_trap; _old_exit_trap="$(trap -p EXIT)"
  trap 'printf "\r\033[K" >&2' EXIT
  while kill -0 "$pid" 2>/dev/null; do
    local elapsed=$(( $(date +%s) - start ))
    printf '\r\033[36m%s\033[0m %s \033[90m%ds\033[0m' \
      "${frames[i % ${#frames[@]}]}" "$label" "$elapsed" >&2
    i=$((i+1))
    sleep 0.1
  done
  printf '\r\033[K' >&2
  eval "${_old_exit_trap:-trap - EXIT}"
}

# Response agent OK? = có .result VÀ is_error != true. claude CLI nhét lỗi API
# ("API Error: 401 ...") vào .result với is_error=true nhưng subtype vẫn "success" —
# chỉ check .result tồn tại là agent chết CÂM: bước sau nhận chuỗi lỗi làm output.
_resp_ok() { jq -e '(.result != null) and (.is_error != true)' "$1" >/dev/null 2>&1; }

#─────────────────────────────────────────────
# Gọi 1 agent qua claude CLI
# stdin: prompt text
# args: $1=agent_name (resolves to kit/agents/<name>.md hoặc kit/skills/<name>.md)
# env:  PAGENT_RUN_DIR, PAGENT_TASK_ID, PAGENT_MODE, PAGENT_AGENT (auto-set)
# stdout: .result text từ claude
# side:  ghi JSON đầy đủ vào $PAGENT_RUN_DIR/<agent>.json
#─────────────────────────────────────────────
call_agent() {
  local agent="$1"; shift
  local prompt; prompt="$(cat)"

  # Resolve agent md — project-local override global
  local md=""
  for cand in \
    "$PAGENT_SOURCE/.pagent/skills/$agent.md" \
    "$PAGENT_SOURCE/.pagent/agents/$agent.md" \
    "$KIT_DIR/skills/$agent.md" \
    "$KIT_DIR/agents/$agent.md"; do
    [[ -f "$cand" ]] && { md="$cand"; break; }
  done
  [[ -n "$md" ]] || die "không tìm thấy agent/skill: $agent (đã check .pagent/ + kit/)"

  local system_prompt;      system_prompt="$(md_body "$md")"
  local allowed;            allowed="$(md_meta "$md" allowed_tools)"
  local disallowed;         disallowed="$(md_meta "$md" disallowed_tools)"
  local sp_mode;            sp_mode="$(md_meta "$md" system_prompt_mode)"   # append | replace
  local max_turns;          max_turns="$(md_meta "$md" max_turns)"
  # Env override cho max_turns — repo lớn cần nhiều lượt khám phá hơn mà không phải sửa md.
  # Ưu tiên: PAGENT_MAX_TURNS_<AGENT> (vd PAGENT_MAX_TURNS_ORCHESTRATOR=40) > PAGENT_MAX_TURNS
  # (global) > giá trị trong frontmatter. Đặt trong .env.pagent của từng project.
  local _mt_var _mt_ov
  _mt_var="PAGENT_MAX_TURNS_$(printf '%s' "$agent" | tr '[:lower:]-' '[:upper:]_')"
  eval "_mt_ov=\"\${$_mt_var:-}\""
  [[ -z "$_mt_ov" ]] && _mt_ov="${PAGENT_MAX_TURNS:-}"
  [[ -n "$_mt_ov" ]] && max_turns="$_mt_ov"
  local caveman;            caveman="$(md_meta "$md" caveman)"               # off | lite | full | ultra
  local mcp_servers;        mcp_servers="$(md_meta "$md" mcp_servers)"        # vd: context7
  local provider;           provider="$(md_meta "$md" provider)"             # claude | openrouter
  provider="${provider:-${PAGENT_PROVIDER:-opencode}}"

  # MCP config: nạp config server cho từng MCP mà agent khai báo dùng
  # (mcp_servers chứa tên server, hoặc allowed_tools tham chiếu tool server đó).
  # Nhiều server → truyền --mcp-config nhiều lần. context7 gate qua PAGENT_CONTEXT7;
  # figma/canvas (design) gate qua PAGENT_DESIGN.
  local mcp_configs=()
  if [[ "${PAGENT_CONTEXT7:-0}" == "1" || "${PAGENT_CONTEXT7:-}" == "true" ]]; then
    if [[ "$mcp_servers" == *context7* || "$allowed" == *context7* ]]; then
      [[ -f "$KIT_DIR/mcp/context7.json" ]] && mcp_configs+=("$KIT_DIR/mcp/context7.json")
    fi
  fi
  if [[ "${PAGENT_DESIGN:-0}" == "1" || "${PAGENT_DESIGN:-}" == "true" ]]; then
    if [[ "$mcp_servers" == *figma* || "$allowed" == *figma* ]]; then
      [[ -f "$KIT_DIR/mcp/figma.json" ]] && mcp_configs+=("$KIT_DIR/mcp/figma.json")
    fi
    if [[ "$mcp_servers" == *canvas* || "$allowed" == *canvas* ]]; then
      [[ -f "$KIT_DIR/mcp/canvas.json" ]] && mcp_configs+=("$KIT_DIR/mcp/canvas.json")
    fi
  fi
  local model;              model="$(md_meta "$md" model)"
  model="${model:-$PAGENT_MODEL}"
  sp_mode="${sp_mode:-append}"
  caveman="${caveman:-${PAGENT_CAVEMAN:-off}}"

  # Inject caveman directive vào HEAD của system_prompt
  case "$caveman" in
    lite)  system_prompt="CAVEMAN MODE LITE — drop pleasantries, hedging, filler. Keep code/paths/errors EXACT.
$system_prompt" ;;
    full)  system_prompt="CAVEMAN MODE FULL — drop articles (a/an/the), filler (just/really/basically/actually), pleasantries. Telegraphic prose OK. Keep code/paths/errors EXACT. Lists > paragraphs.
$system_prompt" ;;
    ultra) system_prompt="CAVEMAN MODE ULTRA — bare tokens. drop articles, copula, fillers, transitions. SVO only. fragments fine. code/paths/errors exact. lists not prose. no preamble. no postamble.
$system_prompt" ;;
    off|"")  : ;;
    *) warn "caveman value lạ: $caveman (dùng off|lite|full|ultra)" ;;
  esac

  # Superpowers gating — CHỈ orchestrator. Phát hiện plugin Superpowers theo provider;
  # có → PAGENT_SUPERPOWERS=1 (orchestrator dùng brainstorming + writing-plans), không → 0.
  # Inject giá trị đã resolve vào system prompt để orchestrator rẽ nhánh; các agent khác không đụng.
  if [[ "$agent" == "orchestrator" ]]; then
    PAGENT_SUPERPOWERS="$(detect_superpowers "$provider")"
    export PAGENT_SUPERPOWERS
    system_prompt="$system_prompt

[RUNTIME] PAGENT_SUPERPOWERS=$PAGENT_SUPERPOWERS"
  fi

  # TDD gating — CHỈ coder. Inject directive TDD bắt buộc (RED→GREEN→REFACTOR) vào
  # system prompt, mô phỏng khối orchestrator ở trên. Resolve body file theo thứ tự
  # project-local → kit (dùng md_body để bóc frontmatter). Thiếu file → bỏ qua êm (warn nhẹ).
  # Nếu phát hiện plugin Superpowers có skill TDD → thêm chỉ dẫn coder invoke Skill.
  if [[ "$agent" == "coder" ]]; then
    local tdd_md=""
    for cand in \
      "$PAGENT_SOURCE/.pagent/skills/test-driven-development.md" \
      "$KIT_DIR/skills/test-driven-development.md"; do
      [[ -f "$cand" ]] && { tdd_md="$cand"; break; }
    done
    if [[ -n "$tdd_md" ]]; then
      local tdd_body; tdd_body="$(md_body "$tdd_md")"
      system_prompt="$system_prompt

[RUNTIME] TDD bắt buộc — tuân thủ directive dưới đây cho mọi implementation:
$tdd_body"
      if [[ "$(detect_superpowers_tdd "$provider")" == "1" ]]; then
        system_prompt="$system_prompt

[RUNTIME] Plugin Superpowers có sẵn — TRƯỚC khi viết code, invoke Skill superpowers:test-driven-development để nạp quy trình TDD đầy đủ."
      fi
    else
      warn "không tìm thấy skill TDD (.pagent/skills/ + kit/skills/test-driven-development.md) — coder chạy không có directive TDD"
    fi
  fi

  local resp_file="$PAGENT_RUN_DIR/$agent.json"
  local out_file="$PAGENT_RUN_DIR/$agent.txt"

  # Pre-hook
  export PAGENT_AGENT="$agent" PAGENT_AGENT_PROVIDER="$provider" PAGENT_AGENT_MODEL="$model"
  [[ -x "$KIT_DIR/hooks/pre.sh" ]] && "$KIT_DIR/hooks/pre.sh" "$prompt" || true

  # Build claude args. Đẩy prompt qua stdin để tránh xung đột với --allowed-tools variadic.
  local backend_pid label
  label="$(c_cyan "[$agent]") thinking…"
  if [[ "$provider" == "openrouter" ]]; then
    label="$(c_cyan "[$agent]") via openrouter ($model)…"
    ( cd "$PAGENT_SOURCE"
      printf '%s' "$prompt" | call_openrouter "$model" "$system_prompt" "$resp_file"
    ) 2>"$PAGENT_RUN_DIR/$agent.err" &
    backend_pid=$!
  elif [[ "$provider" == "opencode" ]]; then
    command -v "$PAGENT_OPENCODE_BIN" >/dev/null || die "thiếu opencode CLI ($PAGENT_OPENCODE_BIN — set PAGENT_OPENCODE_BIN)"
    # Frontmatter model là của claude-cli (tên trần, việc lớn) — opencode KHÔNG dùng:
    # để 9router combo tự phân phối model tối ưu. Chỉ nhận PAGENT_MODEL (provider/model)
    # hoặc rỗng → default config opencode.
    local oc_model="$PAGENT_MODEL"
    [[ "$oc_model" == */* ]] || oc_model=""
    label="$(c_cyan "[$agent]") via opencode (${oc_model:-config-default})…"
    oc_agent_file "$agent" "$system_prompt" "$allowed" "$disallowed"
    [[ ${#mcp_configs[@]} -gt 0 ]] && oc_mcp_config "${mcp_configs[@]}"
    ( printf '%s' "$prompt" | call_opencode "$agent" "$oc_model" "$resp_file"
    ) 2>>"$PAGENT_RUN_DIR/$agent.err" &
    backend_pid=$!
  else
    # Provider claude = việc LỚN (PAGENT_PROVIDER=claude / settings web / frontmatter).
    command -v "$PAGENT_CLAUDE_BIN" >/dev/null || die "thiếu claude CLI ($PAGENT_CLAUDE_BIN — set PAGENT_CLAUDE_BIN)"
    # Model dạng provider/model (opencode-form) vô nghĩa với claude → bỏ, dùng tên trần.
    [[ "$model" == */* ]] && model=""
    model="${model:-$PAGENT_CLAUDE_MODEL}"
    # Direct mode (mặc định): gỡ route gateway để claude CLI dùng thẳng subscription.
    # `env` không -u = passthrough (giữ gateway khi PAGENT_CLAUDE_DIRECT=0).
    local -a _cl_env=(env)
    if _is_truthy "$PAGENT_CLAUDE_DIRECT"; then
      _cl_env+=(-u ANTHROPIC_BASE_URL -u ANTHROPIC_API_KEY)
      label="$(c_cyan "[$agent]") via claude direct ($model)…"
    fi
    # --setting-sources project,local: KHÔNG nạp ~/.claude/settings.json (user scope).
    # Hook PreToolUse global (vd rtk) rewrite `cat`→`rtk read`, `grep`→`rtk grep`… TRƯỚC
    # khi check permission → lệnh đã rewrite không khớp allowed_tools của agent (Bash(cat *)…)
    # → mọi bash bị deny → agent đốt hết max_turns → JSON parse fail. Loại user hook để
    # agent chạy đúng allowlist tự khai trong frontmatter.
    # args KHÔNG gồm --max-turns — vòng resume tái dùng nguyên args + budget mới
    local args=(-p --output-format json --model "$model" --setting-sources project,local)
    if [[ "$sp_mode" == "replace" ]]; then
      args+=(--system-prompt "$system_prompt")
    else
      args+=(--append-system-prompt "$system_prompt")
    fi
    [[ -n "$allowed" ]] && args+=(--allowed-tools "$allowed")
    [[ -n "$disallowed" ]] && args+=(--disallowed-tools "$disallowed")
    local mc
    if [[ ${#mcp_configs[@]} -gt 0 ]]; then
      for mc in "${mcp_configs[@]}"; do args+=(--mcp-config "$mc"); done
    fi
    local first_args=("${args[@]}")
    [[ -n "$max_turns" ]] && first_args+=(--max-turns "$max_turns")
    ( cd "$PAGENT_SOURCE"
      printf '%s' "$prompt" | "${_cl_env[@]}" "$PAGENT_CLAUDE_BIN" "${first_args[@]}"
    ) >"$resp_file" 2>"$PAGENT_RUN_DIR/$agent.err" &
    backend_pid=$!
  fi
  spinner "$backend_pid" "$label"
  wait "$backend_pid" || true

  # Post-hook LUÔN chạy (kể cả khi agent fail) — tránh orphan start event trong tokens log
  [[ -x "$KIT_DIR/hooks/post.sh" ]] && "$KIT_DIR/hooks/post.sh" "$resp_file" || true

  # Resume gate: chạm max_turns → dừng chờ user cấp thêm lượt (web button qua file
  # handshake / tty prompt) rồi tiếp tục ĐÚNG session (--resume) — pipeline không chết.
  # Chỉ provider claude (openrouter không có session resume). Không ai duyệt trong
  # timeout / cap PAGENT_MAX_RESUME vòng → rơi xuống nhánh fail như hành vi cũ.
  # Spec: docs/superpowers/specs/2026-07-03-resume-max-turns-design.md
  local resume_round=0 max_resume="${PAGENT_MAX_RESUME:-3}"
  while [[ "$provider" == "claude" ]] && ! _resp_ok "$resp_file"; do
    local _subtype _sid _used _extra
    _subtype="$(jq -r '.subtype // ""' "$resp_file" 2>/dev/null)"
    _sid="$(jq -r '.session_id // ""' "$resp_file" 2>/dev/null)"
    [[ "$_subtype" == "error_max_turns" && -n "$_sid" ]] || break
    if (( resume_round >= max_resume )); then
      warn "agent $agent đã resume $max_resume lần — không cấp thêm lượt"
      break
    fi
    _used="$(jq -r '.num_turns // 0' "$resp_file" 2>/dev/null)"
    log "$(c_yellow '⏸') $(c_cyan "[$agent]") cạn lượt (đã dùng $_used) — chờ cấp thêm để resume session"
    _extra="$(resume_gate "$agent" "$_sid" "$_used" "${max_turns:-20}")" || break
    resume_round=$((resume_round + 1))
    log "$(c_cyan "[$agent]") resume vòng $resume_round/$max_resume (+$_extra lượt, session ${_sid:0:8}…)"
    local resume_prompt="Bạn bị dừng vì hết lượt (max turns). Tiếp tục từ chỗ đang dở, hoàn thành đúng yêu cầu và format output ban đầu."
    [[ -x "$KIT_DIR/hooks/pre.sh" ]] && "$KIT_DIR/hooks/pre.sh" "$resume_prompt" || true
    ( cd "$PAGENT_SOURCE"
      printf '%s' "$resume_prompt" | "${_cl_env[@]}" "$PAGENT_CLAUDE_BIN" "${args[@]}" --max-turns "$_extra" --resume "$_sid"
    ) >"$resp_file" 2>>"$PAGENT_RUN_DIR/$agent.err" &
    backend_pid=$!
    spinner "$backend_pid" "$(c_cyan "[$agent]") resuming…"
    wait "$backend_pid" || true
    [[ -x "$KIT_DIR/hooks/post.sh" ]] && "$KIT_DIR/hooks/post.sh" "$resp_file" || true
  done

  if ! _resp_ok "$resp_file"; then
    # is_error=true → reason thật nằm trong .result (vd "API Error: 401 ..."); case khác
    # giữ terminal_reason/error như cũ.
    local reason
    reason="$(jq -r '.terminal_reason // .error // (if .is_error == true then .result else null end) // "unknown"' "$resp_file" 2>/dev/null)"
    warn "agent $agent fail (reason=${reason:0:300}) — xem $PAGENT_RUN_DIR/$agent.err"
    tail -20 "$resp_file" >&2
    return 1
  fi
  jq -r '.result' "$resp_file" >"$out_file"
  cat "$out_file"
}

#─────────────────────────────────────────────
# git diff snapshot
#─────────────────────────────────────────────
git_diff_summary() {
  ( cd "$PAGENT_SOURCE" && git diff --stat 2>/dev/null || true )
}
git_diff_full() {
  ( cd "$PAGENT_SOURCE" && git diff 2>/dev/null || true )
}

#─────────────────────────────────────────────
# Context planning (bước [0]) — cache brief keyed git + workflow + knowledge hash
#─────────────────────────────────────────────
# Chọn 1 lần công cụ hash (shasum trên darwin; fallback sha1sum/md5sum/cksum).
_SHA_BIN="$(command -v shasum || command -v sha1sum || command -v md5sum || command -v cksum)"
_sha() { "${_SHA_BIN:-cksum}" 2>/dev/null | awk '{print $1}'; }
# Hash 1 file — thiếu/rỗng → "none" (để key ổn định khi knowledge chưa có).
_hash_file() { [[ -f "$1" ]] && _sha <"$1" || echo none; }

# git state: HEAD commit + working-tree diff → bắt cả thay đổi chưa commit.
context_git_hash() {
  ( cd "$PAGENT_SOURCE" && { git rev-parse HEAD 2>/dev/null; git diff 2>/dev/null; } ) | _sha
}
# workflow spec: agent-workflow.md (spec điều phối feed vào knowledge builder).
context_workflow_hash() { _hash_file "$PAGENT_REPORT_DIR/$PAGENT_PROJECT/agent-workflow.md"; }
# knowledge: gộp 3 file tri thức đã chưng cất (workflow/domain/decisions).
context_knowledge_hash() {
  local k="$PAGENT_SOURCE/.pagent/knowledge"
  { _hash_file "$k/workflow.md"; _hash_file "$k/domain.md"; _hash_file "$k/decisions.md"; } | _sha
}
# Cache key = sha(mode + task + git + workflow + knowledge). Task nằm trong key vì
# brief là context ĐÃ LỌC theo task; đổi bất kỳ tầng nào (code/spec/knowledge) → invalidate.
context_cache_key() {
  printf '%s\0%s\0%s\0%s\0%s' "$1" "$2" \
    "$(context_git_hash)" "$(context_workflow_hash)" "$(context_knowledge_hash)" | _sha
}

# Sinh CONTEXT_BRIEF cho orchestrator qua skill context-planning; cache theo key ở trên.
# stdout: nội dung brief (rỗng nếu degrade). Graceful: thiếu skill / call fail → return 1.
build_context_brief() {
  local mode="$1" task="$2"
  local cp_md=""
  for cand in "$PAGENT_SOURCE/.pagent/skills/context-planning.md" "$KIT_DIR/skills/context-planning.md"; do
    [[ -f "$cand" ]] && { cp_md="$cand"; break; }
  done
  [[ -n "$cp_md" ]] || { warn "context-planning skill thiếu — degrade (bỏ qua CONTEXT_BRIEF)"; return 1; }

  local cache_dir="$PAGENT_REPORT_DIR/$PAGENT_PROJECT/cache"
  mkdir -p "$cache_dir"
  local key; key="$(context_cache_key "$mode" "$task")"
  local cache_file="$cache_dir/context-brief-$key.md"
  if [[ -s "$cache_file" ]]; then
    log "  context-planning: $(c_green 'cache hit') (${key:0:12})"
    cat "$cache_file"; return 0
  fi

  local kdir="$PAGENT_SOURCE/.pagent/knowledge"
  local reports_root="$PAGENT_REPORT_DIR/$PAGENT_PROJECT"
  local brief
  brief="$( {
    echo "## MODE"; echo "$mode"; echo
    echo "## TASK"; echo "$task"; echo
    echo "## SOURCE_SUMMARY_PATH"; echo ".pagent/source-summary.md"; echo
    echo "## KNOWLEDGE_PATHS"
    echo "workflow:  $kdir/workflow.md"
    echo "domain:    $kdir/domain.md"
    echo "decisions: $kdir/decisions.md"; echo
    echo "## FEATURE_REPORTS_DIR"; echo "$reports_root/features"; echo
    echo "## BUG_REPORTS_DIR"; echo "$reports_root/bugs"; echo
    echo "## GIT_DIFF (thay đổi chưa commit — chạy \`git diff\` để xem chi tiết)"
    git_diff_summary
  } | call_agent context-planning )" || { warn "context-planning fail — degrade (bỏ qua CONTEXT_BRIEF)"; return 1; }

  [[ -n "$brief" ]] || return 1
  printf '%s\n' "$brief" >"$cache_file"
  printf '%s' "$brief"
}

#─────────────────────────────────────────────
# Run-lock theo project: cảnh báo khi có run khác đang active trên cùng
# $PAGENT_SOURCE. Coder ghi file thật + git diff sẽ LẪN thay đổi của 2 task
# chạy song song. Warn-only (không block) — lock-file dùng để phát hiện.
#─────────────────────────────────────────────
acquire_run_lock() {
  local lock="$PAGENT_REPORT_DIR/$PAGENT_PROJECT/.run.lock"
  mkdir -p "$(dirname "$lock")"
  if [[ -f "$lock" ]]; then
    local other_pid other_task
    read -r other_pid other_task <"$lock" 2>/dev/null || true
    if [[ -n "${other_pid:-}" ]] && kill -0 "$other_pid" 2>/dev/null; then
      warn "đang có run khác active trên project '$PAGENT_PROJECT' (pid=$other_pid task=${other_task:-?})"
      warn "  coder ghi file thật + git diff CÓ THỂ LẪN thay đổi của 2 task — cân nhắc đợi run kia xong"
    fi
  fi
  printf '%s %s\n' "$$" "$PAGENT_TASK_ID" >"$lock"
  PAGENT_RUN_LOCK="$lock"
  # INT/TERM (vd web bấm Cancel → kill process group) cũng dọn lock + pid để không
  # để lại lock "ma" cảnh báo run sau. Handler tự exit sau khi dọn.
  trap 'release_run_lock; exit 130' INT
  trap 'release_run_lock; exit 143' TERM
  trap 'release_run_lock' EXIT
}
release_run_lock() {
  # pid file (web cancel đọc để kill) — dọn luôn khi thoát/bị kill.
  [[ -n "${PAGENT_RUN_DIR:-}" ]] && rm -f "$PAGENT_RUN_DIR/pagent.pid" 2>/dev/null || true
  [[ -n "${PAGENT_RUN_LOCK:-}" && -f "$PAGENT_RUN_LOCK" ]] || return 0
  # Chỉ xoá nếu lock vẫn của ta (tránh xoá lock của run giành sau cảnh báo)
  local lp; read -r lp _ <"$PAGENT_RUN_LOCK" 2>/dev/null || true
  [[ "${lp:-}" == "$$" ]] && rm -f "$PAGENT_RUN_LOCK"
  return 0
}

#─────────────────────────────────────────────
# Lineage: tham chiếu report cũ qua @<task_id>
#─────────────────────────────────────────────
# Định dạng task_id chuẩn: <YYYYMMDDTHHMMSS>-<pid>-<rand> (xem new_task_id).
PAGENT_TID_RE='[0-9]{8}T[0-9]{6}-[0-9]+-[0-9]+'

# Trích @<task_id> ĐẦU TIÊN trong text (stdin/$1). Stdout: task_id (không @). Exit 1 nếu không có.
extract_parent_ref() {
  local txt="$1"
  [[ "$txt" =~ @($PAGENT_TID_RE) ]] && { printf '%s' "${BASH_REMATCH[1]}"; return 0; }
  return 1
}

# Tìm file report theo task_id (quét 4 loại report). Stdout: path. Exit 1 nếu không thấy.
find_report_by_id() {
  local tid="$1" base="$PAGENT_REPORT_DIR/$PAGENT_PROJECT" sub f
  for sub in features bugs chores findings; do
    for f in "$base/$sub/"*-"$tid".md; do
      [[ -f "$f" ]] && { printf '%s' "$f"; return 0; }
    done
  done
  return 1
}

# Đọc parent id của 1 report file (dòng `**Parent:** <id>`). Rỗng nếu không có.
report_parent_id() {
  grep -m1 '^\*\*Parent:\*\*' "$1" 2>/dev/null | sed -E 's/^\*\*Parent:\*\* *//; s/[^0-9A-Za-z._T-].*$//'
}

# Dựng context lineage: đi từ <task_id> ngược lên gốc, in các report theo thứ tự GỐC→CON
# để orchestrator hiểu task tiến hoá thế nào. Chống cycle + giới hạn độ sâu. Exit 1 nếu rỗng.
build_lineage_context() {
  local cur="$1" depth=0 max=10 seen=" "
  local -a files=()
  while [[ -n "$cur" && $depth -lt $max ]]; do
    [[ "$seen" == *" $cur "* ]] && break       # cycle guard
    seen+="$cur "
    local f; f="$(find_report_by_id "$cur")" || break
    files+=("$f")
    cur="$(report_parent_id "$f")"
    depth=$((depth + 1))
  done
  [[ ${#files[@]} -eq 0 ]] && return 1
  local i
  for (( i=${#files[@]}-1; i>=0; i-- )); do
    local f="${files[i]}" tid
    tid="$(basename "$f" .md | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}-//')"
    printf '### report @%s\n' "$tid"
    head -120 "$f"                               # report nhỏ; cap để chain sâu không phình context
    printf '\n'
  done
}

#─────────────────────────────────────────────
# Build report cuối
#─────────────────────────────────────────────
write_report() {
  local report_path="$1" title="$2" task="$3" risk="$4" affected="$5"
  local date_str; date_str="$(date -u +%Y-%m-%d)"
  local datetime_str; datetime_str="$(date -u +'%Y-%m-%d %H:%M:%S UTC')"

  # Tính tổng cost từ token log
  local log_file="$PAGENT_REPORT_DIR/$PAGENT_PROJECT/tokens/$date_str.jsonl"
  local in_tok=0 out_tok=0 cache_r=0 cost="0.0000"
  if [[ -s "$log_file" ]]; then
    _sum_tokens() {
      jq -s --arg tid "$PAGENT_TASK_ID" '
        [.[] | select(.task_id==$tid and .event=="end")] |
        [
          (map(.input_tokens)    | add // 0),
          (map(.output_tokens)   | add // 0),
          (map(.cache_read)      | add // 0),
          (map(.cost_usd)        | add // 0)
        ] | @tsv
      ' "$log_file" | tr -d '"'
    }
    read -r in_tok out_tok cache_r cost <<<"$(with_lock "$log_file" _sum_tokens)"
  fi

  local plan_f="$PAGENT_RUN_DIR/orchestrator.txt"
  local tester_f="$PAGENT_RUN_DIR/tester.txt"
  local reviewer_f="$PAGENT_RUN_DIR/reviewer.txt"
  local rootcause_f="$PAGENT_RUN_DIR/root_cause.txt"
  local diffstat; diffstat="$(git_diff_summary)"
  [[ -z "$diffstat" ]] && diffstat="(no git diff)"

  # flow_diagram: parse từ plan JSON trong orchestrator.txt. Field vắng/rỗng/parse
  # lỗi → bỏ qua im lặng (chỉ in task) → backward-compat.
  local flow=""
  if [[ -s "$plan_f" ]]; then
    flow="$(extract_json <"$plan_f" 2>/dev/null | jq -r '.flow_diagram // ""' 2>/dev/null || true)"
  fi

  # Tóm tắt test 1 dòng: ưu tiên dòng có count "N passed/failed" hoặc token PASS/FAIL
  # đứng riêng (anchored) → tránh match nhầm prose ("fails to load") / tên file (pass.py).
  local test_line=""
  if [[ -s "$tester_f" ]]; then
    test_line="$(grep -iE '[0-9]+ (passed|failed)|\b(PASS|FAIL)\b' "$tester_f" | head -1 | sed -E 's/^[[:space:]]+//' || true)"
    [[ -z "$test_line" ]] && test_line="(tester chạy — không trích được dòng pass/fail)"
  fi

  {
    printf '# %s\n\n' "$title"
    printf '**Project:** %s\n' "$PAGENT_PROJECT"
    printf '**Mode:** %s\n' "$PAGENT_MODE"
    printf '**Task ID:** %s\n' "$PAGENT_TASK_ID"
    printf '**Ref (copy để nối task sau):** `@%s`\n' "$PAGENT_TASK_ID"
    [[ -n "${PAGENT_PARENT:-}" ]] && printf '**Parent:** %s\n' "$PAGENT_PARENT"
    printf '**Date:** %s\n' "$datetime_str"
    printf '**Risk:** %s\n' "$risk"
    printf '**Total cost:** $%s (%s in / %s out, cache read %s)\n\n' "$cost" "$in_tok" "$out_tok" "$cache_r"
    if [[ -s "$rootcause_f" ]]; then
      printf '## Root cause (review + test, đã xác nhận)\n%s\n\n' "$(cat "$rootcause_f")"
    fi
    printf '## Input\n%s\n' "$task"
    if [[ -n "$flow" ]]; then
      printf '\n**Sơ đồ logic task:**\n```\n%s\n```\n' "$flow"
    fi
    printf '\n## Output\n'
    if [[ "$PAGENT_MODE" == "find" ]]; then
      # find: KHÔNG có coder/diff — reviewer ANSWER chính LÀ deliverable cho user.
      # affected/diffstat/test đều rỗng ở mode này → in thẳng nội dung reviewer.txt.
      if [[ -s "$reviewer_f" ]]; then
        cat "$reviewer_f"
      else
        printf '(reviewer không trả lời được)\n'
      fi
    else
      printf '**Affected files:** %s\n\n' "${affected:-(none)}"
      printf '**Git diff stat:**\n```\n%s\n```\n' "$diffstat"
      [[ -n "$test_line" ]] && printf '\n**Test:** %s\n' "$test_line"
    fi
  } >"$report_path"
}

