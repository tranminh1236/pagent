workflow_file() { echo "$PAGENT_REPORT_DIR/$PAGENT_PROJECT/workflow.md"; }

# Parse các section "## <title>" trong workflow.md → in "<index>\t<title>"
workflow_list_titles() {
  local f="$1"
  awk '/^## /{ sub("^## ",""); printf "%d\t%s\n", ++n, $0 }' "$f"
}

# Extract body của 1 section theo index hoặc title fuzzy match
workflow_section() {
  local f="$1" key="$2"
  awk -v key="$key" '
    /^## / {
      in_sec=0
      title=$0; sub("^## ","",title)
      n++
      if (key+0==n || tolower(title) ~ tolower(key)) { in_sec=1; print; next }
    }
    in_sec { if (/^## /) exit; print }
  ' "$f"
}

cmd_workflow() {
  local action="${1:-show}"; [[ "$#" -gt 0 ]] && shift
  local f; f="$(workflow_file)"

  case "$action" in
    show)
      [[ -f "$f" ]] || die "chưa có $f. Chạy 1 feature trước, hoặc: pagent workflow new <title>"
      if [[ -z "${1:-}" ]]; then
        cat "$f"
      else
        local out; out="$(workflow_section "$f" "$1")"
        [[ -n "$out" ]] || die "không tìm thấy section: $1"
        echo "$out"
      fi
      ;;
    list|ls)
      [[ -f "$f" ]] || die "chưa có $f"
      printf '%s\n' "$(c_green "Workflows in $f:")"
      workflow_list_titles "$f" | awk -F'\t' '{ printf "  [%s] %s\n", $1, $2 }'
      ;;
    run)
      local key="${1:?usage: pagent workflow run <index|title>}"
      [[ -f "$f" ]] || die "chưa có $f"
      local sec cmd
      sec="$(workflow_section "$f" "$key")"
      [[ -n "$sec" ]] || die "không tìm thấy section: $key"
      cmd="$(echo "$sec" | sed -nE 's/^\*\*Smoke test command:\*\*[[:space:]]*`(.+)`[[:space:]]*$/\1/p' | head -1)"
      [[ -n "$cmd" ]] || die "section không có \"Smoke test command\""
      log "$(c_cyan '▶') $cmd"
      ( cd "$PAGENT_SOURCE" && eval "$cmd" )
      ;;
    new)
      local title="${1:?usage: pagent workflow new <title>}"
      mkdir -p "$(dirname "$f")"
      [[ -f "$f" ]] || printf '# Workflow Log — %s\n\n' "$PAGENT_PROJECT" >"$f"
      cat >>"$f" <<EOF

## $title

**Trigger:** TODO
**Preconditions:** TODO
**Flow:**
1. TODO
**Expected outcome:** TODO
**Smoke test command:** \`echo TODO replace with real cmd\`
**Related files:** TODO
**Added:** $(date -u +%Y-%m-%d) (manual)
EOF
      log "$(c_green 'appended:') $f → ## $title"
      log "edit:  \$EDITOR $f"
      ;;
    file)
      echo "$f"
      ;;
    *)
      cat <<'HELP'
pagent workflow <action>
  show [name]      In toàn bộ workflow.md, hoặc 1 section nếu pass tên
  list             Liệt kê các section (index + title)
  run <name>       Chạy "Smoke test command" của section đó (index hoặc fuzzy title)
  new <title>      Append section template mới để edit thủ công
  file             In đường dẫn workflow.md
HELP
      ;;
  esac
}

# Gộp features + bugs report thành khối REPORT_HISTORY cho knowledge builder (cap 40).
_report_history() {
  local root="$PAGENT_REPORT_DIR/$PAGENT_PROJECT" n=0 f
  for f in $(ls -1t "$root/features/"*.md "$root/bugs/"*.md 2>/dev/null); do
    [[ -e "$f" ]] || continue
    (( n++ >= 40 )) && break
    printf '\n### %s\n' "${f#"$root/"}"; cat "$f"
  done
  [[ "$n" -eq 0 ]] && echo "(chưa có report history)"
}

# pagent knowledge [refresh|show] — điều phối 3 skill knowledge:
#   refresh → workflow-knowledge + domain-knowledge (tài liệu SỐNG, merge idempotent)
#   show    → in .pagent/knowledge/{workflow,domain,decisions}.md
# decision-log (append-only) chạy tự động cuối pipeline feature/hotfix, không ở đây.
cmd_knowledge() {
  local action="${1:-show}"; [[ "$#" -gt 0 ]] && shift
  local kdir="$PAGENT_SOURCE/.pagent/knowledge"

  case "$action" in
    refresh)
      mkdir -p "$kdir"
      PAGENT_TASK_ID="$(new_task_id)"; PAGENT_MODE="knowledge"
      PAGENT_RUN_DIR="$PAGENT_REPORT_DIR/$PAGENT_PROJECT/runs/$PAGENT_TASK_ID"
      mkdir -p "$PAGENT_RUN_DIR"
      export PAGENT_TASK_ID PAGENT_MODE PAGENT_RUN_DIR PAGENT_PROJECT PAGENT_REPORT_DIR
      local ss=".pagent/source-summary.md"
      local wf="$PAGENT_REPORT_DIR/$PAGENT_PROJECT/agent-workflow.md"

      log "$(c_cyan 'knowledge refresh') → workflow-knowledge (.pagent/knowledge/workflow.md)"
      {
        echo "## AGENT_WORKFLOW_PATH"; echo "$wf"; echo
        echo "## SOURCE_SUMMARY_PATH"; echo "$ss"; echo
        echo "## REPORT_HISTORY"; _report_history; echo
        echo "## EXISTING_KNOWLEDGE_PATH"; echo "$kdir/workflow.md"
      } | call_agent workflow-knowledge >/dev/null || warn "workflow-knowledge fail (tiếp tục)"

      log "$(c_cyan 'knowledge refresh') → domain-knowledge (.pagent/knowledge/domain.md)"
      {
        echo "## SOURCE_SUMMARY_PATH"; echo "$ss"; echo
        echo "## REPORT_HISTORY"; _report_history; echo
        echo "## EXISTING_KNOWLEDGE_PATH"; echo "$kdir/domain.md"
      } | call_agent domain-knowledge >/dev/null || warn "domain-knowledge fail (tiếp tục)"

      log "$(c_green 'OK') — knowledge refreshed tại $kdir"
      ;;
    show)
      local which="${1:-all}" name f
      for name in workflow domain decisions; do
        [[ "$which" == "all" || "$which" == "$name" ]] || continue
        f="$kdir/$name.md"
        printf '%s\n' "$(c_green "═══ $name.md ═══")"
        if [[ -s "$f" ]]; then cat "$f"; else echo "(chưa có $f — chạy: pagent knowledge refresh)"; fi
        echo
      done
      ;;
    *)
      cat <<'HELP'
pagent knowledge <action>
  refresh                             Rebuild .pagent/knowledge/{workflow,domain}.md
                                      (workflow-knowledge + domain-knowledge; merge idempotent)
  show [workflow|domain|decisions]    In file knowledge (mặc định: cả 3)
HELP
      ;;
  esac
}

