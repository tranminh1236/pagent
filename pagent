}

cmd_help() {
  cat <<'EOF'
pagent — claude-cli orchestrator (coder + reviewer + tester)

USAGE
  pagent init                          Quét source folder, sinh .pagent/source-summary.md
  pagent feature "task..."             Build feature (alias: feat): orchestrator→coder→reviewer→tester→workflow
  pagent fix     "task..."             Hotfix bug:   orchestrator→coder→reviewer→tester regression
  pagent report  [project]             Tóm tắt features/bugs + cost theo ngày
  pagent workflow [show|list|run|new|file]   Quản lý workflow.md (xem 'pagent workflow' để biết)
  pagent skills                        Liệt kê skills/agents project-local + global
  pagent skill new <name>              Scaffold skill mới trong .pagent/skills/
  pagent env                           In biến môi trường đang dùng
  pagent gain [-w|--watch]             Xem rtk savings cho project hiện tại (-w = live)
  pagent web [port] [host]             Bật web dashboard (mặc định http://127.0.0.1:8765)
  pagent help                          Trợ giúp

SKILL RESOLUTION (project-local override global)
  1. $PAGENT_SOURCE/.pagent/skills/<name>.md   ← project-local
  2. $PAGENT_SOURCE/.pagent/agents/<name>.md
  3. $KIT_DIR/skills/<name>.md                  ← fallback global
  4. $KIT_DIR/agents/<name>.md
  Mỗi project có thể override coder/reviewer/feature/... cho stack riêng.

ENVIRONMENT (đặt trong .env.pagent hoặc shell)
  PAGENT_SOURCE             folder source code (mặc định $PWD)
  PAGENT_PROJECT            tên project (mặc định basename của SOURCE)
  PAGENT_REPORT_DIR         nơi lưu report (mặc định ~/.pagent-reports)
  PAGENT_MODEL              claude model (mặc định claude-sonnet-4-6)
  PAGENT_MODE               feature | hotfix (override subcommand)
  PAGENT_CLAUDE_BIN         path tới claude CLI (mặc định "claude")
  PAGENT_MAX_REVIEW_ROUND   số vòng coder↔reviewer (mặc định 2)
  PAGENT_CAVEMAN            off|lite|full|ultra — token compress mode (override md frontmatter)
  PAGENT_OPENROUTER_KEY     OpenRouter API key (sk-or-v1-…) cho fallback khi Claude down
  PAGENT_OPENROUTER_BASE    default: https://openrouter.ai/api/v1
  PAGENT_PROVIDER           claude|openrouter — ép provider toàn pipeline
  PAGENT_KIT_DIR            override kit/ folder

PIPELINE
  1. orchestrator → JSON plan (title, coder_task, reviewer_focus, tester_task, risk)
  2. coder → edit code thật trong $PAGENT_SOURCE, xuất CHANGES block
  3. reviewer (read-only) → APPROVED hoặc CHANGES_REQUESTED (loop tối đa N vòng)
  4. tester → viết test + chạy
  5. workflow-extractor (chỉ feature) → append section vào workflow.md
  6. Pre/post hook → ghi token+cost vào tokens/<date>.jsonl
  7. Auto-compact run dir → bundle.tar.gz

OUTPUT TREE
  $PAGENT_REPORT_DIR/<project>/
    ├── features/<date>-<taskid>.md
    ├── bugs/<date>-<taskid>.md
    ├── workflow.md
    ├── tokens/<date>.jsonl
    └── runs/<taskid>/bundle.tar.gz
EOF
}

#─────────────────────────────────────────────
# Dispatch
#─────────────────────────────────────────────
cmd="${1:-help}"; shift || true
case "$cmd" in
  init)      cmd_init ;;
  feat|feature)   cmd_pipeline feature "${*:-}" ;;
  fix|bug|hotfix) cmd_pipeline hotfix "${*:-}" ;;
  report)    cmd_report "${1:-}" ;;
  workflow)  cmd_workflow "$@" ;;
  env)       cmd_env ;;
  web)
    port="${1:-8765}"; host="${2:-127.0.0.1}"
    [[ -f "$KIT_DIR/web/server.py" ]] || die "kit/web/server.py missing"
    need python3
    log "$(c_cyan 'dashboard:') http://$host:$port  (reports: $PAGENT_REPORT_DIR)"
    PORT="$port" HOST="$host" PAGENT_REPORT_DIR="$PAGENT_REPORT_DIR" \
      exec python3 "$KIT_DIR/web/server.py"
    ;;
  gain)
    if ! command -v rtk >/dev/null; then die "rtk chưa cài"; fi
    if [[ "${1:-}" == "-w" || "${1:-}" == "--watch" ]]; then
      cmd="rtk gain --project; echo; rtk gain -H | head -10"
      if command -v watch >/dev/null; then watch -n 3 "$cmd"
      else while true; do clear; eval "$cmd"; sleep 3; done; fi
    else
      rtk gain --project
    fi
    ;;
  skills|agents) cmd_skills ;;
  skill)
    case "${1:-}" in
      new) shift; cmd_skill_new skill "$@" ;;
      *)   cmd_skills ;;
    esac
    ;;
  agent)
    case "${1:-}" in
      new) shift; cmd_skill_new agent "$@" ;;
      *)   cmd_skills ;;
    esac
    ;;
  -h|--help|help|"") cmd_help ;;
  *)
    # Fallback theo $PAGENT_MODE
    if [[ -n "${PAGENT_MODE:-}" ]]; then
      cmd_pipeline "$PAGENT_MODE" "$cmd $*"
    else
      die "lệnh không biết: $cmd  (chạy: pagent help)"
    fi
    ;;
esac
