# Copy thành .env.pagent ở root project và edit khi cần override.
# pagent auto-source file này nếu tồn tại trong cwd hoặc parent.
#
# KHÔNG cần set PAGENT_PROJECT / PAGENT_SOURCE — pagent tự nhận diện:
#   - PAGENT_SOURCE  = git toplevel của cwd, fallback $PWD nếu không phải git repo
#   - PAGENT_PROJECT = basename của PAGENT_SOURCE
# Chỉ set nếu muốn override (ví dụ project name khác tên folder).

# PAGENT_PROJECT="my-app"
# PAGENT_SOURCE="$HOME/code/foo"

PAGENT_REPORT_DIR="$HOME/.pagent-reports"
PAGENT_MODEL="claude-opus-4-8"
PAGENT_CLAUDE_BIN="claude"
PAGENT_MAX_REVIEW_ROUND=2
# Caveman compression cho mọi agent (off|lite|full|ultra). Override frontmatter agent.
# PAGENT_CAVEMAN="lite"

# Bật MCP context7 (tra doc thư viện version mới nhất) cho agent có khai báo dùng.
# 1|true = bật, 0|unset = tắt. Config server: kit/mcp/context7.json
# PAGENT_CONTEXT7=1

# Fallback model qua OpenRouter (khi Claude rate-limit hoặc down). Set khi cần.
# Khóa lấy từ openrouter.ai/keys. Per-agent dùng provider/model frontmatter.
# PAGENT_OPENROUTER_KEY="sk-or-v1-..."
# PAGENT_OPENROUTER_BASE="https://openrouter.ai/api/v1"
# PAGENT_PROVIDER="openrouter"   # ép TẤT CẢ agent dùng openrouter (chỉ khi agent không cần Write/Edit)

# PAGENT_MODE=""           # feature | hotfix (override subcommand)
# PAGENT_KIT_DIR=""        # override kit/ folder
