# Copy thành .env.pagent ở root project và edit khi cần override.
# pagent auto-source file này nếu tồn tại trong cwd hoặc parent.
#
# KHÔNG cần set PAGENT_PROJECT / PAGENT_SOURCE — pagent tự nhận diện:
#   - PAGENT_SOURCE  = git toplevel của cwd, fallback $PWD nếu không phải git repo
#   - PAGENT_PROJECT = basename của PAGENT_SOURCE
# Chỉ set nếu muốn override (ví dụ project name khác tên folder).

# PAGENT_PROJECT="my-app"
# PAGENT_SOURCE="$HOME/code/foo"

PAGENT_REPORT_DIR="$HOME/.pagent-reports"
PAGENT_MODEL="${PAGENT_MODEL:-}"   # rỗng: web quản (opencode_model); CLI tay → opencode.json default
PAGENT_CLAUDE_BIN="claude"
PAGENT_MAX_REVIEW_ROUND=2
# Tăng max_turns khi repo lớn khiến orchestrator khám phá quá nhiều rồi fail "max_turns".
# Global cho mọi agent, hoặc riêng từng agent (ưu tiên bản _<AGENT>). Mặc định lấy từ frontmatter.
# PAGENT_MAX_TURNS=30
# PAGENT_MAX_TURNS_ORCHESTRATOR=40
# Caveman compression cho mọi agent (off|lite|full|ultra). Override frontmatter agent.
# PAGENT_CAVEMAN="lite"

# Bật MCP context7 (tra doc thư viện version mới nhất) cho agent có khai báo dùng.
# 1|true = bật, 0|unset = tắt. Config server: kit/mcp/context7.json
# PAGENT_CONTEXT7=1

# Bật MCP design (figma + canvas) cho agent designer khi task động đến UI.
# 1|true = bật, 0|unset = tắt. Config server: kit/mcp/figma.json, kit/mcp/canvas.json
# Token đọc từ env (figma.json/canvas.json tham chiếu ${FIGMA_API_KEY}/${CANVAS_API_TOKEN}):
#   export FIGMA_API_KEY="figd_..."        # figma.com → Settings → Personal access tokens
#   export CANVAS_API_TOKEN="..."          # token của canvas/Canva MCP server
# PAGENT_DESIGN=1
# FIGMA_API_KEY="figd_..."
# CANVAS_API_TOKEN="..."

# Bật MCP đọc task (Jira + GitLab) cho agent có khai báo dùng (mặc định orchestrator).
# 1|true = bật. Config: kit/mcp/jira.json (uvx mcp-atlassian) + kit/mcp/gitlab.json
# (npx @zereight/mcp-gitlab). READ-ONLY. NƠI LƯU PAT/TOKEN (json tham chiếu ${...}):
#   Jira Cloud: JIRA_URL + JIRA_USERNAME(email) + JIRA_API_TOKEN (id.atlassian.com → API tokens)
#   Jira Server/DC: đổi jira.json → ${JIRA_PERSONAL_TOKEN}; set JIRA_URL + JIRA_PERSONAL_TOKEN
#   GitLab: GITLAB_API_URL(.../api/v4) + GITLAB_PERSONAL_ACCESS_TOKEN (glpat-…, scope read_api)
# PAGENT_TASKS=1
# JIRA_URL="https://your-org.atlassian.net"
# JIRA_USERNAME="you@company.com"
# JIRA_API_TOKEN="..."
# GITLAB_API_URL="https://gitlab.com/api/v4"
# GITLAB_PERSONAL_ACCESS_TOKEN="glpat-..."

# Fallback model qua OpenRouter (khi Claude rate-limit hoặc down). Set khi cần.
# Khóa lấy từ openrouter.ai/keys. Per-agent dùng provider/model frontmatter.
# PAGENT_OPENROUTER_KEY="sk-or-v1-..."
# PAGENT_OPENROUTER_BASE="https://openrouter.ai/api/v1"
# PAGENT_PROVIDER="openrouter"   # ép TẤT CẢ agent dùng openrouter (chỉ khi agent không cần Write/Edit)

# PAGENT_MODE=""           # feature | hotfix (override subcommand)
# PAGENT_KIT_DIR=""        # override kit/ folder

# Confirm gate: sau khi orchestrator ra plan, pagent in tóm tắt và hỏi xác nhận qua
# /dev/tty ([Enter/y] chạy · [n/q] hủy · gõ text để bổ sung info & re-run orchestrator).
# Tự bỏ qua khi không có tty (chạy tự động / web). Đặt =1 để TẮT gate kể cả khi có tty:
# PAGENT_NO_CONFIRM=1      # bỏ qua confirm, chạy thẳng pipeline
# PAGENT_YES=1             # alias: auto-confirm mọi plan
